#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_NAME="acorn"
PROJECTS_DIR="$HOME/projects"
if [ -d "$HOME/Projects" ]; then
  PROJECTS_DIR="$HOME/Projects"
fi
LIFECYCLE_LABELS=("triage" "ready-for-spec" "spec-in-progress" "spec-review" "spec-approved" "implementing" "in-review" "done")
CLARIFICATION_LABELS=("ai-drafted" "human-clarified")
_SHOW_DEPS=0
_LIST_NWO=""

info() { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  acorn create <repo> <issue-number> [--no-run] [--lite | --quick]
  acorn list [repo] [--deps]
  acorn status [repo]
  acorn approve <repo> <slug>
  acorn spec-complete <repo> <slug>
  acorn clean <repo> <slug> [--remove-labels] [--yes] [--force]
  acorn issue create <repo> <title> [--body <text> | --body-file <path> | --raw] [--label <name>]... [--assignee <login>]... [--blocked-by <issue#>[,<issue#>...]]
  acorn issue plan <repo> <title> [options] [--blocked-by <issue#>[,<issue#>...]] [--no-run] [--lite | --quick]
  acorn issue clarify <repo> <issue-number>
  acorn issue label <repo> <issue-number> <label>
  acorn issue split <repo> <issue-number> [--yes] [--model <model>]
  acorn issue depends <repo> <issue#> [--blocked-by <issue#>[,<issue#>...]] [--remove-blocked-by <issue#>[,<issue#>...]]
  acorn deps graph <repo> <issue#> [<issue#>...]

acorn create runs the pipeline headlessly (acorn shells out to claude -p and
codex exec directly; no tmux, no Task tool) in the background, logging to
<spec>/pipeline.log; the spec lands at <spec>/plans/SPEC.md. --no-run prepares
the spec (PROMPT.md + labels) without launching the pipeline.

Pipeline modes (per-stage models come from the panel; see README "Model panel"):
  (default)   Full 6-stage pipeline, 14 agents: recon, 4 drafts, evaluate,
              synthesize, 4 red team, final spec (Codex/Opus/Sonnet/Fable)
  --lite      Lite 4-stage pipeline, 6 agents: recon, draft, validate, spec
  --quick     Quick 2-stage pipeline, 4 agents: recon, direct spec

Dependency management:
  acorn issue depends <repo> <issue#>                       Show dependencies
  acorn issue depends <repo> <issue#> --blocked-by 5,12     Add blockers
  acorn issue depends <repo> <issue#> --remove-blocked-by 5 Remove a blocker
  acorn deps graph <repo> <issue#> [<issue#>...]            Show wave execution order

Lifecycle labels:
  triage -> ready-for-spec -> spec-in-progress -> spec-review -> spec-approved -> implementing -> in-review -> done
EOF
}

require_cmds() {
  local missing=()
  local cmd
  for cmd in "$@"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    die "Missing required command(s): ${missing[*]}"
  fi
}

# ---------------------------------------------------------------------------
# Model panel + dispatcher
#
# `panel_model <key>` is the single source of truth for which model runs each
# pipeline stage (replaces per-stage model names hardcoded in prose).
# `run_agent` is the only place that knows how to actually call a model: it
# routes Claude tiers (fable/sonnet/opus/haiku/claude-*) to `claude -p` and
# GPT/Codex models (gpt-*/codex/spark) to `codex exec`.
#
# Codex is a SOFT dependency. If it is absent or unauthed, codex models degrade
# to a Claude fallback (ACORN_CODEX_FALLBACK, default "opus") with a warning,
# unless ACORN_STRICT_PANEL=1, which turns degradation into a hard error.
# Force Codex on/off for tests/CI with ACORN_CODEX=1 / ACORN_CODEX=0.
# Override any stage with ACORN_PANEL_<key> (":"/"-" become "_"), e.g.
# ACORN_PANEL_full_recon=haiku.
# ---------------------------------------------------------------------------

# Classify a model name into a backend family.
model_family() {
  case "$1" in
    gpt-*|o3|o3-*|o4-*|codex|codex-*|spark) printf 'codex' ;;
    *)                                       printf 'claude' ;;
  esac
}

# Is Codex usable? Cached after first probe. ACORN_CODEX=0/1 forces the answer.
_ACORN_CODEX_STATUS=""
codex_available() {
  case "${ACORN_CODEX:-auto}" in
    0|no|off) return 1 ;;
    1|yes|on) return 0 ;;
  esac
  if [ -z "$_ACORN_CODEX_STATUS" ]; then
    if command -v codex >/dev/null 2>&1 && codex login status >/dev/null 2>&1; then
      _ACORN_CODEX_STATUS="yes"
    else
      _ACORN_CODEX_STATUS="no"
    fi
  fi
  [ "$_ACORN_CODEX_STATUS" = "yes" ]
}

# Expand model aliases the CLIs do not know natively (the plugin's `spark`).
expand_model_alias() {
  case "$1" in
    spark) printf 'gpt-5.3-codex-spark' ;;
    *)     printf '%s' "$1" ;;
  esac
}

# Apply Codex-availability degradation to a concrete model name.
resolve_model() {
  local m
  m="$(expand_model_alias "$1")"
  if [ "$(model_family "$m")" = "codex" ] && ! codex_available; then
    if [ "${ACORN_STRICT_PANEL:-0}" = "1" ]; then
      die "Panel requires Codex model '$m' but codex is unavailable/unauthed (ACORN_STRICT_PANEL=1)"
    fi
    warn "Codex model '$m' unavailable; falling back to '${ACORN_CODEX_FALLBACK:-opus}'"
    printf '%s' "${ACORN_CODEX_FALLBACK:-opus}"
    return 0
  fi
  printf '%s' "$m"
}

# Raw table lookup + env override. Returns the unresolved model name.
panel_raw() {
  local key="$1"
  local envkey ovr
  envkey="ACORN_PANEL_$(printf '%s' "$key" | tr ':-' '__')"
  eval "ovr=\${$envkey:-}"
  if [ -n "$ovr" ]; then
    printf '%s' "$ovr"
    return 0
  fi
  case "$key" in
    full:recon|lite:recon|quick:recon) printf 'sonnet' ;;
    full:draft:minimal)                printf 'gpt-5.6-sol' ;;
    full:draft:architecture)           printf 'opus' ;;
    full:draft:robustness)             printf 'sonnet' ;;
    full:draft:dx)                     printf 'fable' ;;
    full:evaluate)                     printf 'opus' ;;
    full:synthesize)                   printf 'opus' ;;
    full:redteam:1)                    printf 'gpt-5.6-sol' ;;
    full:redteam:2)                    printf 'opus' ;;
    full:redteam:3)                    printf 'sonnet' ;;
    full:redteam:4)                    printf 'fable' ;;
    full:spec)                         printf 'fable' ;;
    lite:draft)                        printf 'opus' ;;
    lite:validate)                     printf 'sonnet' ;;
    lite:spec)                         printf 'opus' ;;
    quick:spec)                        printf 'opus' ;;
    split)                             printf 'sonnet' ;;
    *) die "panel_model: unknown stage key '$key'" ;;
  esac
}

# Public accessor. A second arg of "--claude-only" forces codex-family stages to
# their Claude fallback — used when interpolating models into the interactive
# planning prose, since the Claude Code Task tool cannot launch Codex agents.
panel_model() {
  local key="$1"
  local claude_only=0
  [ "${2:-}" = "--claude-only" ] && claude_only=1
  local raw
  raw="$(panel_raw "$key")"
  if [ "$claude_only" -eq 1 ] && [ "$(model_family "$raw")" = "codex" ]; then
    printf '%s' "${ACORN_CODEX_FALLBACK:-opus}"
    return 0
  fi
  printf '%s' "$raw"
}

# Pull the first valid JSON object out of model output. Tiers, in order:
#   1. the whole text is already valid JSON
#   2. the content of the FIRST ```json-tagged fence
#   3. the content of the FIRST generic ``` fence
# Both fence tiers extract only the first fenced block (awk, stopping at the
# closing fence) so multiple fences aren't concatenated into invalid JSON.
extract_json() {
  local text="$1" inner
  if printf '%s' "$text" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$text"
    return 0
  fi
  inner="$(printf '%s' "$text" | awk '
    /^[[:space:]]*```[Jj][Ss][Oo][Nn][[:space:]]*$/ {inb=1; next}
    inb && /^[[:space:]]*```[[:space:]]*$/ {exit}
    inb {print}')"
  if [ -n "$inner" ] && printf '%s' "$inner" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$inner"
    return 0
  fi
  inner="$(printf '%s' "$text" | awk '
    !seen && /^[[:space:]]*```/ {seen=1; inb=1; next}
    inb && /^[[:space:]]*```[[:space:]]*$/ {exit}
    inb {print}')"
  if [ -n "$inner" ] && printf '%s' "$inner" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$inner"
    return 0
  fi
  return 1
}

# run_agent <model> <out_file> [--format text|json] [--schema <file>] [--cwd <dir>] [--tools none|read]
# Prompt is read from stdin. Writes the model's final answer to <out_file>
# atomically (tmp then mv), so a failed call never truncates a prior artifact.
# Warns and returns non-zero on any failure.
#
# Tool policy (SECURITY): the prompt embeds untrusted GitHub issue text, so
# agents must NOT be able to run Bash / Write / Edit. We never pass
# --dangerously-skip-permissions. `none` grants no tools (headless -p denies any
# tool the model tries — verified: it does not hang). `read` allows Read/Glob/
# Grep for codebase exploration and still denies everything else. Codex is
# already sandboxed read-only, which covers both policies.
run_agent() {
  local model="$1" out="$2"
  shift 2
  local format="text" schema="" cwd="." tools="none"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format) format="${2:-}"; shift 2 ;;
      --schema) schema="${2:-}"; shift 2 ;;
      --cwd)    cwd="${2:-}";    shift 2 ;;
      --tools)  tools="${2:-}";  shift 2 ;;
      *) die "run_agent: unknown option '$1'" ;;
    esac
  done
  case "$format" in text|json) ;; *) die "run_agent: --format must be text or json" ;; esac
  case "$tools" in none|read) ;; *) die "run_agent: --tools must be none or read" ;; esac

  local prompt
  prompt="$(cat)"
  model="$(resolve_model "$model")"

  if [ "$(model_family "$model")" = "codex" ]; then
    run_agent_codex "$model" "$out" "$format" "$schema" "$cwd" "$tools" "$prompt"
  else
    run_agent_claude "$model" "$out" "$format" "$schema" "$cwd" "$tools" "$prompt"
  fi
}

run_agent_claude() {
  local model="$1" out="$2" format="$3" schema="$4" cwd="$5" tools="$6" prompt="$7"
  require_cmds claude jq
  # No --dangerously-skip-permissions. --disallowedTools hard-denies the
  # dangerous tools regardless of the user's settings (verified: an exclusive
  # deny even when project settings "allow" them); `read` additionally
  # allowlists the read-only exploration tools. Untrusted issue text can never
  # reach Bash/Write/Edit this way.
  local tool_args=(--disallowedTools "Bash Write Edit NotebookEdit")
  case "$tools" in
    read) tool_args+=(--allowedTools "Read Glob Grep") ;;
    none) ;;
  esac
  local tmp="$out.tmp.$$" err
  err="$(mktemp)"
  if [ "$format" = "json" ]; then
    if [ -n "$schema" ] && [ -f "$schema" ]; then
      prompt="${prompt}

Respond with ONLY a JSON object that conforms to this JSON Schema. No markdown fencing, no prose:
$(cat "$schema")"
    fi
    local envelope text
    if ! envelope="$( cd "$cwd" && printf '%s' "$prompt" | claude -p "${tool_args[@]}" --model "$model" --output-format json 2>"$err" )"; then
      warn "run_agent: claude call failed (model=$model): $(head -c 500 "$err" 2>/dev/null)"; rm -f "$err"; return 1
    fi
    rm -f "$err"
    text="$(printf '%s' "$envelope" | jq -r '.result // empty')"
    [ -n "$text" ] || { warn "run_agent: claude returned no result (model=$model)"; return 1; }
    text="$(extract_json "$text")" \
      || { warn "run_agent: claude output was not valid JSON (model=$model)"; return 1; }
    printf '%s' "$text" > "$tmp" && mv "$tmp" "$out" || { rm -f "$tmp"; return 1; }
  else
    if ! ( cd "$cwd" && printf '%s' "$prompt" | claude -p "${tool_args[@]}" --model "$model" ) > "$tmp" 2>"$err"; then
      warn "run_agent: claude call failed (model=$model): $(head -c 500 "$err" 2>/dev/null)"; rm -f "$tmp" "$err"; return 1
    fi
    rm -f "$err"
    # A zero-exit but empty response must NOT clobber a prior good artifact.
    [ -s "$tmp" ] || { warn "run_agent: claude produced empty output (model=$model)"; rm -f "$tmp"; return 1; }
    mv "$tmp" "$out"
  fi
}

run_agent_codex() {
  local model="$1" out="$2" format="$3" schema="$4" cwd="$5" tools="$6" prompt="$7"
  require_cmds codex jq
  # `codex exec -s read-only` sandboxes the model's shell to read-only (no
  # writes, no network egress), but unlike Claude's --disallowedTools it cannot
  # be made fully tool-less: a codex agent can still READ local files and echo
  # them back in its reply. That reply stays in the user's terminal (no exfil to
  # the issue author under read-only), but for the untrusted-text `none` path
  # (e.g. `acorn issue split` on a codex model) a Claude model is safer; warn.
  if [ "$tools" = "none" ]; then
    warn "run_agent: codex model '$model' analyzing untrusted text runs in codex's read-only sandbox (can read local files); a Claude model is preferred here."
  fi
  local tmp="$out.tmp.$$" err
  err="$(mktemp)"
  local args
  args=(exec -m "$model" --skip-git-repo-check -s read-only -o "$tmp")
  if [ "$cwd" != "." ]; then
    args+=(--cd "$cwd")
  fi
  if [ "$format" = "json" ] && [ -n "$schema" ] && [ -f "$schema" ]; then
    args+=(--output-schema "$schema")
  fi
  args+=("$prompt")
  if ! codex "${args[@]}" >/dev/null 2>"$err"; then
    warn "run_agent: codex call failed (model=$model): $(head -c 500 "$err" 2>/dev/null)"; rm -f "$tmp" "$err"; return 1
  fi
  rm -f "$err"
  if [ "$format" = "json" ]; then
    local text
    text="$(extract_json "$(cat "$tmp")")" \
      || { warn "run_agent: codex output was not valid JSON (model=$model)"; rm -f "$tmp"; return 1; }
    printf '%s' "$text" > "$tmp"
  fi
  # A zero-exit but empty response must NOT clobber a prior good artifact.
  [ -s "$tmp" ] || { warn "run_agent: codex produced empty output (model=$model)"; rm -f "$tmp"; return 1; }
  mv "$tmp" "$out"
}

repo_main_path() {
  local repo="$1"
  printf '%s/%s/main' "$PROJECTS_DIR" "$repo"
}

spec_root() {
  local repo="$1"
  printf '%s/.specs' "$(repo_main_path "$repo")"
}

spec_dir() {
  local repo="$1"
  local slug="$2"
  printf '%s/%s' "$(spec_root "$repo")" "$slug"
}

safe_repo_main() {
  local repo="$1"
  local repo_main
  repo_main="$(repo_main_path "$repo")"
  [ -d "$repo_main" ] || die "Repo path not found: $repo_main"
  printf '%s' "$repo_main"
}

slugify_title() {
  local title="$1"
  local s
  if command -v iconv >/dev/null 2>&1; then
    s="$(printf '%s' "$title" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null || printf '%s' "$title")"
  else
    s="$title"
  fi

  s="$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]')"
  s="$(printf '%s' "$s" | tr ' _' '--')"
  s="$(printf '%s' "$s" | sed -E 's/[^a-z0-9-]+/-/g; s/-+/-/g; s/^-+//; s/-+$//')"
  s="$(printf '%s' "$s" | cut -c1-50)"
  s="$(printf '%s' "$s" | sed -E 's/-+$//')"

  if [ -z "$s" ]; then
    s="issue"
  fi
  printf '%s' "$s"
}

build_slug() {
  local issue_number="$1"
  local title="$2"
  printf '%s-%s' "$issue_number" "$(slugify_title "$title")"
}


issue_number_from_slug() {
  local slug="$1"
  printf '%s' "$slug" | sed -nE 's/^([0-9]+)-.*/\1/p'
}

truncate_str() {
  local str="$1"
  local max_len="${2:-40}"
  if [ "${#str}" -gt "$max_len" ]; then
    printf '%s...' "${str:0:$((max_len - 3))}"
  else
    printf '%s' "$str"
  fi
}

gh_issue_json() {
  local repo_main="$1"
  local issue_number="$2"
  (
    cd "$repo_main"
    gh issue view "$issue_number" --json number,title,body,labels,comments,url,assignees
  )
}

ensure_labels() {
  local repo_main="$1"
  local label color

  # Lifecycle labels with distinct colors per stage
  local lifecycle_colors
  lifecycle_colors="triage:d73a4a"
  lifecycle_colors="$lifecycle_colors ready-for-spec:0e8a16"
  lifecycle_colors="$lifecycle_colors spec-in-progress:1d76db"
  lifecycle_colors="$lifecycle_colors spec-review:fbca04"
  lifecycle_colors="$lifecycle_colors spec-approved:0052cc"
  lifecycle_colors="$lifecycle_colors implementing:5319e7"
  lifecycle_colors="$lifecycle_colors in-review:f9d0c4"
  lifecycle_colors="$lifecycle_colors done:cccccc"

  for label in "${LIFECYCLE_LABELS[@]}"; do
    color="$(printf '%s' "$lifecycle_colors" | tr ' ' '\n' | grep "^${label}:" | cut -d: -f2)"
    [ -n "$color" ] || color="0052cc"
    (
      cd "$repo_main"
      gh label create "$label" --color "$color" --description "Acorn lifecycle" --force >/dev/null 2>&1
    ) || true
  done

  for label in "${CLARIFICATION_LABELS[@]}"; do
    (
      cd "$repo_main"
      gh label create "$label" --color "e4e669" --description "Acorn clarification status" --force >/dev/null 2>&1
    ) || true
  done
}

remove_issue_label_soft() {
  local repo_main="$1"
  local issue_number="$2"
  local label="$3"
  (
    cd "$repo_main"
    gh issue edit "$issue_number" --remove-label "$label" >/dev/null 2>&1
  ) || warn "Unable to remove label '$label' from issue #$issue_number"
}

add_issue_label_hard() {
  local repo_main="$1"
  local issue_number="$2"
  local label="$3"
  (
    cd "$repo_main"
    gh issue edit "$issue_number" --add-label "$label" >/dev/null
  ) || die "Failed adding label '$label' on issue #$issue_number"
}

set_issue_state_label() {
  local repo_main="$1"
  local issue_number="$2"
  local target="$3"
  local label

  for label in "${LIFECYCLE_LABELS[@]}"; do
    if [ "$label" != "$target" ]; then
      remove_issue_label_soft "$repo_main" "$issue_number" "$label"
    fi
  done

  add_issue_label_hard "$repo_main" "$issue_number" "$target"
}

set_clarification_label() {
  local repo_main="$1"
  local issue_number="$2"
  local target="$3"
  local label

  for label in "${CLARIFICATION_LABELS[@]}"; do
    if [ "$label" != "$target" ]; then
      remove_issue_label_soft "$repo_main" "$issue_number" "$label"
    fi
  done

  add_issue_label_hard "$repo_main" "$issue_number" "$target"
}

comment_issue() {
  local repo_main="$1"
  local issue_number="$2"
  local body="$3"
  (
    cd "$repo_main"
    gh issue comment "$issue_number" --body "$body" >/dev/null
  ) || warn "Failed posting comment on issue #$issue_number"
}

# Resolve GitHub owner/repo (nameWithOwner) from local repo path.
gh_repo_nwo() {
  local repo_main="$1"
  (
    cd "$repo_main"
    gh repo view --json nameWithOwner -q '.nameWithOwner'
  ) || die "Failed to resolve GitHub repo name from: $repo_main"
}

# Fetch issues that block a given issue.
# Returns JSON array from GitHub API, or '[]' on failure.
get_blocked_by() {
  local repo_main="$1"
  local issue_number="$2"
  local nwo="${3:-}"
  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  local result
  result="$(
    cd "$repo_main"
    gh api "repos/${nwo}/issues/${issue_number}/dependencies/blocked_by" 2>/dev/null
  )" || { printf '[]'; return 0; }

  if printf '%s' "$result" | jq -e 'type == "array"' >/dev/null 2>&1; then
    printf '%s' "$result"
  else
    printf '[]'
  fi
}

# Fetch issues that a given issue blocks (reverse direction).
# Returns JSON array, or '[]' on failure.
get_blocking() {
  local repo_main="$1"
  local issue_number="$2"
  local nwo="${3:-}"
  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  local result
  result="$(
    cd "$repo_main"
    gh api "repos/${nwo}/issues/${issue_number}/dependencies/blocking" 2>/dev/null
  )" || { printf '[]'; return 0; }

  if printf '%s' "$result" | jq -e 'type == "array"' >/dev/null 2>&1; then
    printf '%s' "$result"
  else
    printf '[]'
  fi
}

# Add a single blocked-by relationship.
# Returns 0 on success, 1 on failure (with warning).
add_blocked_by_dependency() {
  local repo_main="$1"
  local issue_number="$2"
  local blocker_number="$3"
  local nwo="${4:-}"

  case "$blocker_number" in
    ''|*[!0-9]*) warn "Invalid issue number for --blocked-by: '$blocker_number'"; return 1 ;;
  esac
  [ "$blocker_number" -gt 0 ] 2>/dev/null || { warn "Invalid issue number for --blocked-by: '$blocker_number'"; return 1; }

  if [ "$issue_number" = "$blocker_number" ]; then
    warn "Issue #$issue_number cannot block itself"
    return 1
  fi

  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  info "Adding dependency: #$issue_number blocked by #$blocker_number"
  (
    cd "$repo_main"
    gh api --method POST \
      "repos/${nwo}/issues/${issue_number}/dependencies/blocked_by" \
      -f blocked_by_issue_number="$blocker_number" >/dev/null
  ) || { warn "Failed to add blocked-by #$blocker_number for issue #$issue_number"; return 1; }
}

# Remove a single blocked-by relationship.
# Returns 0 on success, 1 on failure (with warning).
remove_blocked_by_dependency() {
  local repo_main="$1"
  local issue_number="$2"
  local blocker_number="$3"
  local nwo="${4:-}"

  case "$blocker_number" in
    ''|*[!0-9]*) warn "Invalid issue number for --remove-blocked-by: '$blocker_number'"; return 1 ;;
  esac

  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  info "Removing dependency: #$issue_number no longer blocked by #$blocker_number"
  (
    cd "$repo_main"
    gh api --method DELETE \
      "repos/${nwo}/issues/${issue_number}/dependencies/blocked_by/${blocker_number}" >/dev/null
  ) || { warn "Failed to remove blocked-by #$blocker_number from issue #$issue_number"; return 1; }
}

# Detect if adding "issue_number blocked-by blocker_number" would create a cycle.
# Returns 0 if cycle detected, 1 if safe.
detect_circular_dependency() {
  local repo_main="$1"
  local issue_number="$2"
  local blocker_number="$3"
  local nwo="${4:-}"
  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"

  local visited="$issue_number"

  _cycle_dfs() {
    local current="$1"
    local blockers_json
    blockers_json="$(get_blocked_by "$repo_main" "$current" "$nwo")"
    local dep_num
    while IFS= read -r dep_num; do
      [ -n "$dep_num" ] || continue
      if [ "$dep_num" = "$issue_number" ]; then
        return 0
      fi
      case " $visited " in
        *" $dep_num "*) continue ;;
      esac
      visited="$visited $dep_num"
      _cycle_dfs "$dep_num" && return 0
    done < <(printf '%s' "$blockers_json" | jq -r '.[].number // empty')
    return 1
  }

  _cycle_dfs "$blocker_number"
  local result=$?
  unset -f _cycle_dfs 2>/dev/null || true
  return $result
}

# Add multiple blocked-by dependencies with cycle detection.
add_blocked_by_bulk() {
  local repo_main="$1"
  local issue_number="$2"
  shift 2
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"
  local num
  for num in "$@"; do
    num="$(printf '%s' "$num" | tr -d '[:space:]')"
    [ -n "$num" ] || continue
    if detect_circular_dependency "$repo_main" "$issue_number" "$num" "$nwo"; then
      warn "Circular dependency: adding #$num as blocker of #$issue_number would create a cycle. Skipping."
      continue
    fi
    add_blocked_by_dependency "$repo_main" "$issue_number" "$num" "$nwo" || true
  done
}

# Return the count of issues blocking a given issue.
blocked_by_count() {
  local repo_main="$1"
  local issue_number="$2"
  local nwo="${3:-}"
  local json
  json="$(get_blocked_by "$repo_main" "$issue_number" "$nwo")"
  printf '%s' "$json" | jq 'length'
}

# Build dependency graph for a set of issues.
# Output: lines of "ISSUE BLOCKER" pairs, or "ISSUE NONE" for unblocked issues.
build_dependency_graph() {
  local repo_main="$1"
  shift
  local issues=("$@")
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"

  local issue
  for issue in "${issues[@]}"; do
    local blockers_json
    blockers_json="$(get_blocked_by "$repo_main" "$issue" "$nwo")"
    local has_dep=0
    local dep_num
    while IFS= read -r dep_num; do
      [ -n "$dep_num" ] || continue
      local in_set=0
      local check
      for check in "${issues[@]}"; do
        [ "$check" != "$dep_num" ] || { in_set=1; break; }
      done
      if [ "$in_set" -eq 1 ]; then
        printf '%s %s\n' "$issue" "$dep_num"
        has_dep=1
      fi
    done < <(printf '%s' "$blockers_json" | jq -r '.[].number // empty')
    if [ "$has_dep" -eq 0 ]; then
      printf '%s NONE\n' "$issue"
    fi
  done
}

# Topological sort using Kahn's algorithm.
# Reads dependency pairs from stdin ("ISSUE BLOCKER" or "ISSUE NONE").
# Outputs waves separated by "---" lines.
topological_sort_waves() {
  # Space-join the issue/wave lists and split them with a space-only IFS.
  # The global IFS is $'\n\t' (space removed on purpose), so `for x in $list`
  # would otherwise treat "1 2 3" as a single token and collapse every issue
  # into one wave. `local IFS` keeps this scoped and never leaks to the caller.
  local IFS=' '
  local all_issues=""
  local edges=""

  while IFS=' ' read -r issue dep; do
    case " $all_issues " in
      *" $issue "*) ;;
      *) all_issues="$all_issues $issue" ;;
    esac
    if [ "$dep" != "NONE" ]; then
      edges="$edges|$issue $dep"
    fi
  done

  all_issues="${all_issues# }"
  [ -n "$all_issues" ] || return 0

  local remaining="$all_issues"
  local wave_num=0

  while [ -n "$remaining" ]; do
    wave_num=$((wave_num + 1))
    local wave_issues=""

    local candidate
    for candidate in $remaining; do
      local is_blocked=0
      IFS='|'
      local edge
      for edge in $edges; do
        [ -n "$edge" ] || continue
        local e_blocked="${edge%% *}"
        local e_blocker="${edge##* }"
        if [ "$e_blocked" = "$candidate" ]; then
          case " $remaining " in
            *" $e_blocker "*) is_blocked=1; break ;;
          esac
        fi
      done
      IFS=' '
      if [ "$is_blocked" -eq 0 ]; then
        wave_issues="$wave_issues $candidate"
      fi
    done

    wave_issues="${wave_issues# }"

    if [ -z "$wave_issues" ]; then
      die "Circular dependency detected in batch: remaining issues [$remaining] have unresolvable dependencies"
    fi

    if [ "$wave_num" -gt 1 ]; then
      printf -- '---\n'
    fi
    local wi
    for wi in $wave_issues; do
      printf '%s\n' "$wi"
    done

    local new_remaining=""
    local r
    for r in $remaining; do
      case " $wave_issues " in
        *" $r "*) ;;
        *) new_remaining="$new_remaining $r" ;;
      esac
    done
    remaining="${new_remaining# }"
  done
}





render_comments_block() {
  local issue_json="$1"
  printf '%s\n' "$issue_json" | jq -r '
    if (.comments | length) == 0 then
      "_No discussion comments yet._"
    else
      .comments[] |
      "### Comment by @\(.author.login // "unknown") on \(.updatedAt // .createdAt // "unknown-time")\n\n\(.body // "")\n"
    end
  '
}

# PROMPT.md carries only requirements + discussion; the stage plan is code
# (run_pipeline), not prose. The pipeline's recon/draft/spec agents Read this file.
render_prompt_md() {
  local issue_title="$1"
  local issue_body="$2"
  local issue_json="$3"
  local out_tmp="$4"
  local url_mapping_file="${5:-}"

  # Rewrite image URLs in body if mapping exists
  if [ -n "$url_mapping_file" ] && [ -f "$url_mapping_file" ] && [ -s "$url_mapping_file" ]; then
    issue_body="$(rewrite_image_urls_in_text "$issue_body" "$url_mapping_file")"
  fi

  {
    printf '# Feature Spec: %s\n\n' "$issue_title"
    printf '## Requirements\n\n'
    if [ -n "$issue_body" ]; then
      printf '%s\n\n' "$issue_body"
    else
      printf '_No issue body provided._\n\n'
    fi

    printf '## Discussion / Context\n\n'
    local comments_text
    comments_text="$(render_comments_block "$issue_json")"
    if [ -n "$url_mapping_file" ] && [ -f "$url_mapping_file" ] && [ -s "$url_mapping_file" ]; then
      comments_text="$(rewrite_image_urls_in_text "$comments_text" "$url_mapping_file")"
    fi
    printf '%s' "$comments_text"
    printf '\n---\n\n'
    cat <<'EOF'
## Completion Protocol

When implementation is complete, the implementing agent must:

1. Create or update `DONE.md` in the spec directory.
2. Include the exact test commands run and their outcomes.
3. Summarize file changes and rationale in concise bullet points.
4. List any follow-up risks or deferred work.
EOF
  } > "$out_tmp"
}


# Lean PROMPT.md (headless mode) has no methodology anchor — validate it carries
# the requirements section instead.
validate_prompt_md_lean() {
  local prompt_path="$1"
  grep -q '^## Requirements' "$prompt_path" || return 1
  return 0
}

# ---------------------------------------------------------------------------
# Headless pipeline (Phase 2)
#
# acorn drives the pipeline directly: each stage fans out run_agent calls (real
# Claude AND Codex models straight from the panel — no --claude-only) in
# parallel, captures each agent's final message to an artifact file, then moves
# on. No interactive Claude, no tmux, no Task tool. Prompts are agent-facing and
# concise: the "you are a SUB-AGENT / return only Done / write in ~4000-token
# chunks" scaffolding the tmux design needed is gone, because the orchestrator
# owns file-writing and sequencing. Agents run with the target repo as cwd so
# they explore the real codebase, and reference absolute paths under the spec
# directory. Prompts are deliberately non-prescriptive (state the goal, not a
# rigid procedure) — over-prescriptive prompts reduce output quality on the
# strongest models (notably Fable 5, used for the full-mode final spec).
# ---------------------------------------------------------------------------

# recon_prompt <facet> <spec_dir_abs>   facet: architecture|relevant_code|conventions
recon_prompt() {
  local facet="$1" spec_dir="$2"
  printf 'Read %s/PROMPT.md to understand the feature being planned, then explore this repository with Glob, Grep, and Read to ground the plan in what actually exists.\n\n' "$spec_dir"
  case "$facet" in
    architecture)
      printf '%s\n' 'Focus on architecture and structure: directory layout, tech stack and frameworks, the build and deployment model, key entry points and main modules, and the data layer (schemas, storage). Reference concrete file paths.'
      printf 'VISUAL ASSETS: if %s/images/ contains screenshots, mockups, or diagrams referenced by the requirements, use the Read tool to examine them for visual context.\n' "$spec_dir"
      ;;
    relevant_code)
      printf '%s\n' 'Focus on the code this feature will touch: the files and modules most likely to change, the existing APIs / endpoints / interfaces involved, the data models and types affected, integration points with other systems, and related existing functionality. Include real function signatures and file:line references.'
      ;;
    conventions)
      printf '%s\n' 'Focus on conventions and constraints: coding style and naming, error-handling patterns, the test framework and how tests are written, CI and quality gates, dependency management, reusable utilities worth using, and anything in CLAUDE.md / AGENTS.md / contributing docs. Give concrete examples.'
      ;;
    *) die "recon_prompt: unknown facet '$facet'" ;;
  esac
  printf '\n%s\n' 'Return your complete findings as clear markdown that references specific file paths. Do NOT create or write any files — your reply IS the artifact. No preamble, no meta-commentary about what you did.'
}

# quick_spec_prompt <spec_dir_abs>
quick_spec_prompt() {
  local spec_dir="$1"
  cat <<EOF
You are producing a complete, implementation-ready specification for a feature.

Read these files:
- ${spec_dir}/PROMPT.md — the requirements and discussion
- ${spec_dir}/recon/architecture.md — how the codebase is structured
- ${spec_dir}/recon/relevant_code.md — the code this feature will touch
- ${spec_dir}/recon/conventions.md — the patterns to follow

Explore the repository further with Glob, Grep, and Read wherever the recon is thin or you need to confirm a detail.

Produce a SPEC.md an implementing agent can follow without guessing. Cover:
- A short overview of what is being built and why.
- The concrete files to create or change, and the specific change in each.
- A step-by-step implementation plan in dependency order.
- Data model, schema, and API / interface changes.
- Testing strategy: what to test and how, matching this repo's test conventions.
- Edge cases and failure modes to handle.
- A traceability check mapping each acceptance criterion from PROMPT.md to where the plan satisfies it.

Ground every claim in the actual codebase and reference real file paths. Do NOT create or write any files — your reply IS the spec. Output only the spec markdown.
EOF
}

# draft_prompt <lens> <spec_dir_abs>   lens: minimal|architecture|robustness|dx
draft_prompt() {
  local lens="$1" spec_dir="$2"
  printf 'Produce a complete, independent implementation plan for the feature described in %s/PROMPT.md.\n\n' "$spec_dir"
  printf 'Read %s/recon/architecture.md, %s/recon/relevant_code.md, and %s/recon/conventions.md for codebase context, and explore further with Glob/Grep/Read where you need to confirm a detail.\n\n' "$spec_dir" "$spec_dir" "$spec_dir"
  case "$lens" in
    minimal)      printf '%s\n' 'YOUR LENS — Minimal Surgery: achieve the requirements with the smallest possible change set. Touch the fewest files, reuse what exists, avoid new abstractions, and prefer modifying existing code over adding new files.' ;;
    architecture) printf '%s\n' 'YOUR LENS — Clean Architecture: design the cleanest long-term structure, with proper separation of concerns and clear interfaces, even if that means a larger change. Optimise for how the code should be shaped, not for minimal diff.' ;;
    robustness)   printf '%s\n' 'YOUR LENS — Robustness First: put correctness, edge cases, and failure modes at the centre. Handle error paths and boundary conditions explicitly, and validate at system boundaries.' ;;
    dx)           printf '%s\n' 'YOUR LENS — Developer Experience: optimise for clarity, testability, and maintainability. Make the change easy to understand, easy to test, and pleasant to work on later.' ;;
    *) die "draft_prompt: unknown lens '$lens'" ;;
  esac
  printf '\n%s\n' 'Give the plan the full treatment through this lens: overview, files to change with the specific change in each, a step-by-step implementation order, data/API changes, testing approach, and edge cases. Commit to the lens even where a different lens would choose otherwise. Ground every claim in the real codebase with file paths. Do NOT create or write any files — your reply IS the plan. Output only the plan markdown.'
}

# evaluate_prompt <spec_dir_abs>
evaluate_prompt() {
  local spec_dir="$1"
  cat <<EOF
Evaluate four competing implementation plans for the same feature and recommend a path forward.

Read the requirements in ${spec_dir}/PROMPT.md, the codebase context in ${spec_dir}/recon/, and the four drafts:
- ${spec_dir}/plans/draft_plan_1.md (minimal surgery lens)
- ${spec_dir}/plans/draft_plan_2.md (clean architecture lens)
- ${spec_dir}/plans/draft_plan_3.md (robustness lens)
- ${spec_dir}/plans/draft_plan_4.md (developer experience lens)

Score each draft on: requirement coverage, fit with the existing codebase and conventions, simplicity, risk, and testability. For each, give its strongest ideas and its weaknesses. Then recommend which draft (or which combination of ideas from several) should form the basis of the master plan, and say why.

Ground your judgements in the drafts and the codebase. Do NOT create or write any files — your reply IS the evaluation. Output only the evaluation markdown.
EOF
}

# synthesis_prompt <spec_dir_abs>
synthesis_prompt() {
  local spec_dir="$1"
  cat <<EOF
Synthesise a single master implementation plan from four competing drafts and their evaluation.

Read ${spec_dir}/PROMPT.md, ${spec_dir}/recon/, the four drafts in ${spec_dir}/plans/draft_plan_1..4.md, and the scoring in ${spec_dir}/plans/evaluation.md.

Produce the master plan: take the best ideas from each draft, resolve conflicts between them deliberately (state the call you made and why), and cover overview, files to change with the specific change in each, step-by-step implementation order, data/API changes, testing strategy, and edge cases. It should be coherent as one plan, not a stapling-together of four.

Ground every claim in the real codebase with file paths. Do NOT create or write any files — your reply IS the master plan. Output only the master plan markdown.
EOF
}

# redteam_prompt <angle> <spec_dir_abs>   angle: requirements|ambiguity|edge|integration
redteam_prompt() {
  local angle="$1" spec_dir="$2"
  printf 'You are an adversarial reviewer. Your job is to find what is WRONG or MISSING in the master plan at %s/plans/master_plan.md, not to praise it.\n\n' "$spec_dir"
  printf 'Read %s/PROMPT.md (the requirements) and %s/recon/ for context, and check the plan against the real codebase with Glob/Grep/Read.\n\n' "$spec_dir" "$spec_dir"
  case "$angle" in
    requirements) printf '%s\n' 'ANGLE — Requirements coverage: go requirement by requirement from PROMPT.md. Is each one addressed in the plan, and where exactly? Is each acceptance criterion testable and unambiguous? What is missing or only partially covered?' ;;
    ambiguity)    printf '%s\n' 'ANGLE — Ambiguity: find every place two competent developers would implement the plan differently, where information a developer needs is missing, or where the plan relies on implicit knowledge. Assume the least charitable reading.' ;;
    edge)         printf '%s\n' 'ANGLE — Edge cases and failure modes: find the inputs, states, and error paths the plan does not handle. Empty/oversized/malformed inputs, concurrency, partial failure, rollback, and boundary conditions.' ;;
    integration)  printf '%s\n' 'ANGLE — Integration and ordering: find broken or unstated integration points, wrong dependency ordering, unhandled side effects, and backward-compatibility or migration problems with existing code.' ;;
    *) die "redteam_prompt: unknown angle '$angle'" ;;
  esac
  printf '\n%s\n' 'List concrete, specific findings (each with where in the plan and why it matters); do not soften them. If the plan genuinely handles something well in your area, say so briefly, but lead with the problems. Do NOT create or write any files — your reply IS the review. Output only the findings markdown.'
}

# final_spec_prompt <spec_dir_abs>   (full mode: resolve red-team findings into SPEC.md)
final_spec_prompt() {
  local spec_dir="$1"
  cat <<EOF
Produce the final, implementation-ready SPEC.md by hardening the master plan against four adversarial reviews.

Read ${spec_dir}/PROMPT.md, ${spec_dir}/recon/, the master plan ${spec_dir}/plans/master_plan.md, and the four red-team reviews ${spec_dir}/plans/red_team_1..4.md.

Produce a SPEC.md an implementing agent can follow without guessing. Cover:
- A short overview of what is being built and why.
- The concrete files to create or change, and the specific change in each.
- A step-by-step implementation plan in dependency order.
- Data model, schema, and API / interface changes.
- Testing strategy: what to test and how, matching this repo's test conventions.
- Edge cases and failure modes to handle.
- A traceability check mapping each acceptance criterion from PROMPT.md to where the plan satisfies it.
- A red-team resolution log: for each material finding from the four reviews, how the spec addresses it (or a reasoned decision not to).

Ground every claim in the real codebase and reference file paths. Do NOT create or write any files — your reply IS the spec. Output only the spec markdown.
EOF
}

# lite_draft_prompt <spec_dir_abs>   (lite mode: one comprehensive draft)
lite_draft_prompt() {
  local spec_dir="$1"
  cat <<EOF
Produce a single, comprehensive implementation plan for the feature in ${spec_dir}/PROMPT.md.

Read ${spec_dir}/recon/architecture.md, ${spec_dir}/recon/relevant_code.md, and ${spec_dir}/recon/conventions.md, and explore further with Glob/Grep/Read where needed.

Balance the concerns a strong engineer weighs at once: a small, clean change that reuses what exists; correctness and edge cases; and testability. Cover overview, files to change with the specific change in each, step-by-step order, data/API changes, testing approach, and edge cases.

Ground every claim in the real codebase with file paths. Do NOT create or write any files — your reply IS the plan. Output only the plan markdown.
EOF
}

# lite_validate_prompt <spec_dir_abs>   (lite mode: validate the single draft)
lite_validate_prompt() {
  local spec_dir="$1"
  cat <<EOF
Validate an implementation plan against the requirements and the real codebase before it becomes the final spec.

Read ${spec_dir}/PROMPT.md, ${spec_dir}/recon/, and the plan at ${spec_dir}/plans/draft_plan_1.md. Check the plan against the actual code with Glob/Grep/Read.

Report, concretely: (1) requirement coverage — is each requirement and acceptance criterion addressed and testable; (2) codebase fact-check — does the plan reference the code accurately, or are there wrong assumptions; (3) ambiguities a developer would hit; (4) edge cases and failure modes the plan misses. Be specific about where and why.

Do NOT create or write any files — your reply IS the validation report. Output only the findings markdown.
EOF
}

# lite_spec_prompt <spec_dir_abs>   (lite mode: incorporate validation into SPEC.md)
lite_spec_prompt() {
  local spec_dir="$1"
  cat <<EOF
Produce the final, implementation-ready SPEC.md by incorporating validation findings into the plan.

Read ${spec_dir}/PROMPT.md, ${spec_dir}/recon/, the plan ${spec_dir}/plans/draft_plan_1.md, and the validation report ${spec_dir}/plans/validation.md.

Produce a SPEC.md an implementing agent can follow without guessing, folding in every material validation finding. Cover:
- A short overview of what is being built and why.
- The concrete files to create or change, and the specific change in each.
- A step-by-step implementation plan in dependency order.
- Data model, schema, and API / interface changes.
- Testing strategy: what to test and how, matching this repo's test conventions.
- Edge cases and failure modes to handle.
- A traceability check mapping each acceptance criterion from PROMPT.md to where the plan satisfies it.

Ground every claim in the real codebase and reference file paths. Do NOT create or write any files — your reply IS the spec. Output only the spec markdown.
EOF
}

# _run_fanout <label> <repo_main> [<model> <out> <prompt>]...
# Launches each (model, out, prompt) agent in parallel (read-only tools), waits
# for all, and dies if any artifact is missing/empty.
_run_fanout() {
  local label="$1" repo_main="$2"
  shift 2
  info "$label"
  local pids=() outs=() rc=0
  while [ "$#" -ge 3 ]; do
    local model="$1" out="$2" prompt="$3"
    shift 3
    printf '%s' "$prompt" | run_agent "$model" "$out" --format text --cwd "$repo_main" --tools read &
    pids+=("$!"); outs+=("$out")
  done
  local pid; for pid in "${pids[@]}"; do wait "$pid" || rc=1; done
  local o; for o in "${outs[@]}"; do
    [ -s "$o" ] || { warn "agent artifact missing or empty: $o"; rc=1; }
  done
  [ "$rc" -eq 0 ] || die "$label failed — see warnings above"
}

# run_single_stage <label> <model> <out> <repo_main> <prompt>
run_single_stage() {
  local label="$1" model="$2" out="$3" repo_main="$4" prompt="$5"
  info "$label (model=$model)"
  printf '%s' "$prompt" | run_agent "$model" "$out" --format text --cwd "$repo_main" --tools read \
    || die "$label failed"
  [ -s "$out" ] || die "$label produced no output ($out)"
}

# run_recon <model> <spec_dir_abs> <repo_main_abs>  (3 facets in parallel)
run_recon() {
  local model="$1" spec_dir="$2" repo_main="$3"
  _run_fanout "Stage 0: reconnaissance (3 agents, model=$model)" "$repo_main" \
    "$model" "$spec_dir/recon/architecture.md"  "$(recon_prompt architecture "$spec_dir")" \
    "$model" "$spec_dir/recon/relevant_code.md" "$(recon_prompt relevant_code "$spec_dir")" \
    "$model" "$spec_dir/recon/conventions.md"   "$(recon_prompt conventions "$spec_dir")"
  info "Stage 0 complete: recon/{architecture,relevant_code,conventions}.md"
}

# run_pipeline <mode> <spec_dir_abs> <repo_main_abs>
run_pipeline() {
  local mode="$1" spec_dir="$2" repo_main="$3"
  case "$mode" in
    quick) run_pipeline_quick "$spec_dir" "$repo_main" ;;
    lite)  run_pipeline_lite  "$spec_dir" "$repo_main" ;;
    full)  run_pipeline_full  "$spec_dir" "$repo_main" ;;
    *) die "run_pipeline: unknown mode '$mode'" ;;
  esac
}

run_pipeline_quick() {
  local spec_dir="$1" repo_main="$2"
  info "Headless pipeline (quick): recon=$(panel_model quick:recon), spec=$(panel_model quick:spec)"
  run_recon "$(panel_model quick:recon)" "$spec_dir" "$repo_main"
  run_single_stage "Stage 1: final spec" "$(panel_model quick:spec)" \
    "$spec_dir/plans/SPEC.md" "$repo_main" "$(quick_spec_prompt "$spec_dir")"
  info "Stage 1 complete: plans/SPEC.md"
}

run_pipeline_lite() {
  local spec_dir="$1" repo_main="$2"
  info "Headless pipeline (lite): recon=$(panel_model lite:recon), draft=$(panel_model lite:draft), validate=$(panel_model lite:validate), spec=$(panel_model lite:spec)"
  run_recon "$(panel_model lite:recon)" "$spec_dir" "$repo_main"
  run_single_stage "Stage 1: comprehensive draft" "$(panel_model lite:draft)" \
    "$spec_dir/plans/draft_plan_1.md" "$repo_main" "$(lite_draft_prompt "$spec_dir")"
  run_single_stage "Stage 2: validation" "$(panel_model lite:validate)" \
    "$spec_dir/plans/validation.md" "$repo_main" "$(lite_validate_prompt "$spec_dir")"
  run_single_stage "Stage 3: final spec" "$(panel_model lite:spec)" \
    "$spec_dir/plans/SPEC.md" "$repo_main" "$(lite_spec_prompt "$spec_dir")"
  info "Pipeline complete: plans/SPEC.md"
}

run_pipeline_full() {
  local spec_dir="$1" repo_main="$2"
  info "Headless pipeline (full): recon=$(panel_model full:recon), drafts=[$(panel_model full:draft:minimal)/$(panel_model full:draft:architecture)/$(panel_model full:draft:robustness)/$(panel_model full:draft:dx)], synth=$(panel_model full:synthesize), spec=$(panel_model full:spec)"

  run_recon "$(panel_model full:recon)" "$spec_dir" "$repo_main"

  _run_fanout "Stage 1: diverse drafting (4 agents)" "$repo_main" \
    "$(panel_model full:draft:minimal)"      "$spec_dir/plans/draft_plan_1.md" "$(draft_prompt minimal "$spec_dir")" \
    "$(panel_model full:draft:architecture)" "$spec_dir/plans/draft_plan_2.md" "$(draft_prompt architecture "$spec_dir")" \
    "$(panel_model full:draft:robustness)"   "$spec_dir/plans/draft_plan_3.md" "$(draft_prompt robustness "$spec_dir")" \
    "$(panel_model full:draft:dx)"           "$spec_dir/plans/draft_plan_4.md" "$(draft_prompt dx "$spec_dir")"
  info "Stage 1 complete: 4 drafts"

  run_single_stage "Stage 2: evaluation" "$(panel_model full:evaluate)" \
    "$spec_dir/plans/evaluation.md" "$repo_main" "$(evaluate_prompt "$spec_dir")"

  run_single_stage "Stage 3: synthesis" "$(panel_model full:synthesize)" \
    "$spec_dir/plans/master_plan.md" "$repo_main" "$(synthesis_prompt "$spec_dir")"

  _run_fanout "Stage 4: adversarial red team (4 agents)" "$repo_main" \
    "$(panel_model full:redteam:1)" "$spec_dir/plans/red_team_1.md" "$(redteam_prompt requirements "$spec_dir")" \
    "$(panel_model full:redteam:2)" "$spec_dir/plans/red_team_2.md" "$(redteam_prompt ambiguity "$spec_dir")" \
    "$(panel_model full:redteam:3)" "$spec_dir/plans/red_team_3.md" "$(redteam_prompt edge "$spec_dir")" \
    "$(panel_model full:redteam:4)" "$spec_dir/plans/red_team_4.md" "$(redteam_prompt integration "$spec_dir")"
  info "Stage 4 complete: 4 red-team reviews"

  run_single_stage "Stage 5: final spec" "$(panel_model full:spec)" \
    "$spec_dir/plans/SPEC.md" "$repo_main" "$(final_spec_prompt "$spec_dir")"
  info "Pipeline complete: plans/SPEC.md"
}

get_extension_from_url() {
  local url="$1"
  # Strip query parameters and fragments
  local path="${url%%\?*}"
  path="${path%%#*}"
  # Extract extension
  local ext="${path##*.}"
  # Lowercase
  ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  case "$ext" in
    png|jpg|jpeg|gif|webp|svg) printf '%s' "$ext" ;;
    *) printf 'png' ;;
  esac
}

generate_image_filename() {
  local url="$1"
  local ext
  ext="$(get_extension_from_url "$url")"

  local hash
  if command -v md5 >/dev/null 2>&1; then
    hash="$(printf '%s' "$url" | md5)"
  elif command -v md5sum >/dev/null 2>&1; then
    hash="$(printf '%s' "$url" | md5sum | cut -d' ' -f1)"
  else
    hash="$(printf '%s' "$url" | cksum | cut -d' ' -f1)"
  fi

  printf '%s.%s' "$hash" "$ext"
}

extract_image_urls() {
  local issue_json="$1"

  # Combine body and all comment bodies into a text stream
  local all_text
  all_text="$(printf '%s' "$issue_json" | jq -r '
    [.body // ""] + [(.comments // [])[] | .body // ""]
    | .[]
  ')" || true

  [ -z "$all_text" ] && return 0

  {
    # Strategy 1: Standard image URLs with known extensions
    printf '%s' "$all_text" \
      | grep -oE '!\[[^]]*\]\([^)]+\)' \
      | sed -nE 's/.*\(([^ ")]+).*/\1/p' \
      | grep -iE '\.(png|jpe?g|gif|webp|svg)(\?[^[:space:]]*)?$' \
      || true

    # Strategy 2: GitHub asset UUID URLs (no extension)
    printf '%s' "$all_text" \
      | grep -oE '!\[[^]]*\]\([^)]+\)' \
      | sed -nE 's/.*\(([^ ")]+).*/\1/p' \
      | grep -E '^https://(github\.com/.*/assets/[0-9a-f-]+|private-user-images\.githubusercontent\.com/)' \
      || true
  } | sort -u
}

extract_and_download_images() {
  local issue_json="$1"
  local images_dir="$2"

  require_cmds curl

  local mapping_file
  mapping_file="$(mktemp)"

  mkdir -p "$images_dir"

  local urls
  urls="$(extract_image_urls "$issue_json")"

  if [ -z "$urls" ]; then
    info "No images found in issue" >&2
    printf '%s' "$mapping_file"
    return 0
  fi

  local url count=0 success=0
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    count=$((count + 1))

    local filename
    filename="$(generate_image_filename "$url")"
    local output_path="$images_dir/$filename"
    local relative_path="images/$filename"

    # Skip if already downloaded (idempotent)
    if [ -f "$output_path" ] && [ -s "$output_path" ]; then
      info "Image already exists: $relative_path" >&2
      printf '%s\t%s\n' "$url" "$relative_path" >> "$mapping_file"
      success=$((success + 1))
      continue
    fi

    # Download to temp file first, then move (atomic)
    local tmp_download="$output_path.tmp"
    if curl -fsSL --max-time 30 --retry 2 -o "$tmp_download" "$url" 2>/dev/null; then
      if [ -s "$tmp_download" ]; then
        mv "$tmp_download" "$output_path"
        info "Downloaded: $relative_path" >&2
        printf '%s\t%s\n' "$url" "$relative_path" >> "$mapping_file"
        success=$((success + 1))
      else
        warn "Downloaded file is empty: $url"
        rm -f "$tmp_download"
      fi
    else
      warn "Failed to download image: $url (keeping original URL)"
      rm -f "$tmp_download"
    fi
  done <<< "$urls"

  info "Images: $success/$count downloaded successfully" >&2
  printf '%s' "$mapping_file"
}

rewrite_image_urls_in_text() {
  local text="$1"
  local mapping_file="$2"

  # Return text unchanged if no mapping
  [ -n "$mapping_file" ] && [ -f "$mapping_file" ] && [ -s "$mapping_file" ] || {
    printf '%s' "$text"
    return 0
  }

  local result="$text"
  local original_url local_path
  while IFS=$'\t' read -r original_url local_path; do
    [ -n "$original_url" ] || continue
    # Use bash string replacement -- no sed escaping needed
    result="${result//"$original_url"/$local_path}"
  done < "$mapping_file"

  printf '%s' "$result"
}

write_meta_json() {
  local path="$1"
  local repo="$2"
  local issue_number="$3"
  local issue_title="$4"
  local slug="$5"
  local mode="${6:-full}"

  local ts
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  jq -n \
    --arg repo "$repo" \
    --argjson issue_number "$issue_number" \
    --arg issue_title "$issue_title" \
    --arg slug "$slug" \
    --arg created_at "$ts" \
    --arg mode "$mode" \
    '{repo:$repo, issue_number:$issue_number, issue_title:$issue_title, slug:$slug, created_at:$created_at, mode:$mode}' \
    > "$path"
}

file_mtime_epoch() {
  local path="$1"
  if stat -f '%m' "$path" >/dev/null 2>&1; then
    stat -f '%m' "$path"
  else
    stat -c '%Y' "$path"
  fi
}

human_age() {
  local epoch="$1"
  local now
  now="$(date +%s)"
  local diff=$((now - epoch))
  if [ "$diff" -lt 60 ]; then
    printf '%ss' "$diff"
  elif [ "$diff" -lt 3600 ]; then
    printf '%sm' $((diff / 60))
  elif [ "$diff" -lt 86400 ]; then
    printf '%sh' $((diff / 3600))
  else
    printf '%sd' $((diff / 86400))
  fi
}

status_for_spec() {
  local repo_main="$1"
  local issue_number="$2"
  local spec_path="$3"

  local labels_json='[]'
  if [ -n "$issue_number" ]; then
    labels_json="$(
      cd "$repo_main"
      gh issue view "$issue_number" --json labels 2>/dev/null | jq -c '.labels // []'
    )" || true
  fi

  # Return the actual lifecycle label if present.
  local label found=""
  for label in "${LIFECYCLE_LABELS[@]}"; do
    if printf '%s' "$labels_json" | jq -e --arg l "$label" '.[] | select(.name == $l)' >/dev/null 2>&1; then
      found="$label"
      break
    fi
  done

  if [ -n "$found" ]; then
    printf '%s' "$found"
  else
    # Backward-compatible fallback for older unlabeled issues.
    local final_exists=0
    local prompt_exists=0
    [ -f "$spec_path/plans/SPEC.md" ] && final_exists=1
    [ -f "$spec_path/PROMPT.md" ] && prompt_exists=1

    if [ "$final_exists" -eq 1 ]; then
      printf 'review'
    elif [ "$prompt_exists" -eq 1 ]; then
      printf 'planning'
    else
      printf 'unknown'
    fi
  fi
}

clarification_for_issue() {
  local repo_main="$1"
  local issue_number="$2"

  [ -n "$issue_number" ] || { printf -- '--'; return 0; }

  local labels_json
  labels_json="$(
    cd "$repo_main"
    gh issue view "$issue_number" --json labels 2>/dev/null | jq -c '.labels // []'
  )" || { printf -- '--'; return 0; }

  if printf '%s' "$labels_json" | jq -e '.[] | select(.name == "human-clarified")' >/dev/null 2>&1; then
    printf 'clarified'
  elif printf '%s' "$labels_json" | jq -e '.[] | select(.name == "ai-drafted")' >/dev/null 2>&1; then
    printf 'ai-drafted'
  else
    printf -- '--'
  fi
}

print_list_header() {
  printf '%-16s %-8s %-40s %-18s %-6s %-8s %-11s %-6s %s\n' "repo" "issue" "slug" "status" "mode" "age" "clarify" "deps" "spec_path"
}

print_list_row() {
  local repo="$1"
  local issue="$2"
  local slug="$3"
  local status="$4"
  local mode="$5"
  local age="$6"
  local clarify="$7"
  local deps="$8"
  local path="$9"
  printf '%-16s %-8s %-40s %-18s %-6s %-8s %-11s %-6s %s\n' "$repo" "$issue" "$slug" "$status" "$mode" "$age" "$clarify" "$deps" "$path"
}

print_status_header() {
  printf '%-16s %-42s %-10s %-18s %-6s %s\n' \
    "REPO" "SLUG" "RUN" "STATUS" "MODE" "SPEC"
}

print_status_row() {
  local repo="$1"
  local slug="$2"
  local run="$3"
  local status="$4"
  local mode="$5"
  local spec="$6"
  printf '%-16s %-42s %-10s %-18s %-6s %s\n' \
    "$repo" "$slug" "$run" "$status" "$mode" "$spec"
}

# Run state of a headless pipeline from its pid file + log:
#   running  live pid
#   done     PIPELINE_EXIT=0 (or SPEC.md present with no log)
#   failed   PIPELINE_EXIT=<non-zero>
#   stopped  log started but no exit line and no live pid (killed/crashed)
#   idle     prepared, never run
pipeline_run_state() {
  local dir="$1"
  if [ -f "$dir/pipeline.pid" ]; then
    local p; p="$(cat "$dir/pipeline.pid" 2>/dev/null || true)"
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then printf 'running'; return 0; fi
  fi
  if [ -f "$dir/pipeline.log" ]; then
    local ex
    ex="$(grep -oE 'PIPELINE_EXIT=[0-9]+' "$dir/pipeline.log" 2>/dev/null | tail -1 | cut -d= -f2)"
    if [ "$ex" = "0" ]; then printf 'done'; return 0; fi
    if [ -n "$ex" ]; then printf 'failed'; return 0; fi
    printf 'stopped'; return 0
  fi
  [ -s "$dir/plans/SPEC.md" ] && printf 'done' || printf 'idle'
}

list_specs_for_repo() {
  local repo="$1"
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local root
  root="$(spec_root "$repo")"
  [ -d "$root" ] || return 0

  local dir
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue
    local slug
    slug="$(basename "$dir")"
    local issue
    issue="$(issue_number_from_slug "$slug")"
    local status
    status="$(status_for_spec "$repo_main" "$issue" "$dir")"
    local clarify
    clarify="$(clarification_for_issue "$repo_main" "$issue")"
    local mode="full"
    if [ -f "$dir/meta.json" ]; then
      mode="$(jq -r '.mode // "full"' "$dir/meta.json" 2>/dev/null || printf 'full')"
    fi
    local age
    age="$(human_age "$(file_mtime_epoch "$dir")")"
    local deps="--"
    if [ "$_SHOW_DEPS" -eq 1 ] && [ -n "$issue" ] && [ "$issue" != "?" ]; then
      local _list_nwo
      _list_nwo="${_LIST_NWO:-}"
      if [ -z "$_list_nwo" ]; then
        _list_nwo="$(gh_repo_nwo "$repo_main" 2>/dev/null || true)"
        _LIST_NWO="$_list_nwo"
      fi
      if [ -n "$_list_nwo" ]; then
        local dep_count
        dep_count="$(blocked_by_count "$repo_main" "$issue" "$_list_nwo" 2>/dev/null || printf '0')"
        if [ "$dep_count" -gt 0 ] 2>/dev/null; then
          deps="$dep_count"
        fi
      fi
    fi
    print_list_row "$repo" "${issue:-?}" "$slug" "$status" "$mode" "$age" "$clarify" "$deps" "$dir"
  done
}

list_specs_all() {
  local main_dir
  for main_dir in "$PROJECTS_DIR"/*/main; do
    [ -d "$main_dir" ] || continue
    local repo
    repo="$(basename "$(dirname "$main_dir")")"
    if [ -d "$main_dir/.specs" ]; then
      list_specs_for_repo "$repo"
    fi
  done
}

list_status_for_repo() {
  local repo="$1"
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local root
  root="$(spec_root "$repo")"
  [ -d "$root" ] || return 0

  local dir
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue

    local slug
    slug="$(basename "$dir")"

    local mode="full"
    if [ -f "$dir/meta.json" ]; then
      mode="$(jq -r '.mode // "full"' "$dir/meta.json" 2>/dev/null || echo full)"
    fi

    local run_state
    run_state="$(pipeline_run_state "$dir")"

    local issue
    issue="$(issue_number_from_slug "$slug")"
    local pipeline_status
    pipeline_status="$(status_for_spec "$repo_main" "$issue" "$dir")"

    local spec_marker="-"
    [ -s "$dir/plans/SPEC.md" ] && spec_marker="SPEC.md"

    local display_slug
    display_slug="$(truncate_str "$slug" 40)"

    print_status_row "$repo" "$display_slug" "$run_state" "$pipeline_status" "$mode" "$spec_marker"
  done
}

list_status_all() {
  local main_dir
  for main_dir in "$PROJECTS_DIR"/*/main; do
    [ -d "$main_dir" ] || continue
    local repo
    repo="$(basename "$(dirname "$main_dir")")"
    if [ -d "$main_dir/.specs" ]; then
      list_status_for_repo "$repo"
    fi
  done
}

cmd_create() {
  local repo="$1"
  local issue_number="$2"
  shift 2

  local mode="full"
  local run_now=1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-run)
        run_now=0
        ;;
      --lite)
        [ "$mode" = "full" ] || die "--lite and --quick are mutually exclusive"
        mode="lite"
        ;;
      --quick)
        [ "$mode" = "full" ] || die "--lite and --quick are mutually exclusive"
        mode="quick"
        ;;
      *)
        die "Unknown option for create: $1"
        ;;
    esac
    shift
  done

  require_cmds gh jq claude
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  info "Fetching issue #$issue_number"
  local issue_json
  issue_json="$(gh_issue_json "$repo_main" "$issue_number")" || die "Failed to fetch issue #$issue_number"

  local title body slug root dir
  title="$(printf '%s' "$issue_json" | jq -r '.title // "Untitled issue"')"
  body="$(printf '%s' "$issue_json" | jq -r '.body // ""')"
  slug="$(build_slug "$issue_number" "$title")"
  root="$(spec_root "$repo")"
  dir="$(spec_dir "$repo" "$slug")"

  mkdir -p "$dir/plans" "$dir/recon" "$dir/images"

  # Concurrency guard: refuse a second run for the same spec while one is live
  # (they would clobber each other's recon/plan artifacts and log). Done before
  # any GitHub side effect so a rejected run posts no duplicate comment.
  if [ -f "$dir/pipeline.pid" ]; then
    local existing_pid
    existing_pid="$(cat "$dir/pipeline.pid" 2>/dev/null || true)"
    if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
      die "A pipeline is already running for this spec (pid $existing_pid). Wait for it, or 'acorn clean $repo $slug' to stop it."
    fi
    rm -f "$dir/pipeline.pid"  # stale pid file from a previous run
  fi

  # PROMPT.md holds requirements + discussion for the agents to read; the stage
  # plan is code, not prose. It is mode-independent, so an existing one is always
  # safe to reuse — regenerate only if missing or if it is a legacy prompt that
  # still carries the removed planning methodology.
  local prompt_path="$dir/PROMPT.md"
  if [ ! -f "$prompt_path" ] || grep -q 'PLANNING METHODOLOGY' "$prompt_path"; then
    info "Extracting images from issue #$issue_number"
    local url_mapping_file
    url_mapping_file="$(extract_and_download_images "$issue_json" "$dir/images")"

    local tmp_path="$prompt_path.tmp"
    render_prompt_md "$title" "$body" "$issue_json" "$tmp_path" "$url_mapping_file"
    if ! validate_prompt_md_lean "$tmp_path"; then
      rm -f "$tmp_path" "$url_mapping_file"
      die "Prompt generation failed: requirements section missing"
    fi
    mv "$tmp_path" "$prompt_path"
    rm -f "$url_mapping_file"
    info "Generated $prompt_path"
  else
    info "PROMPT.md already exists, leaving as-is"
  fi

  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_number" "spec-in-progress"
  comment_issue "$repo_main" "$issue_number" "Spec started locally at: $dir"

  write_meta_json "$dir/meta.json" "$repo" "$issue_number" "$title" "$slug" "$mode"

  if [ "$run_now" -eq 0 ]; then
    echo ""
    local mode_flag=""
    [ "$mode" != "full" ] && mode_flag=" --$mode"
    echo "Created spec: $dir  (mode: $mode)"
    echo "Prepared but not run (--no-run). Launch it with: acorn create $repo $issue_number${mode_flag}"
    return 0
  fi

  local logf="$dir/pipeline.log" pidf="$dir/pipeline.pid"
  : > "$logf"
  # Run the pipeline detached so the terminal is free during long (full-mode)
  # runs. `|| rc=$?` captures the exit without `set -e` aborting the recorder
  # before it logs PIPELINE_EXIT, so a failed run is distinguishable from a
  # still-running one. The pid file lets `acorn clean` stop an in-flight run.
  (
    rc=0
    ( run_pipeline "$mode" "$dir" "$repo_main" ) >> "$logf" 2>&1 || rc=$?
    printf 'PIPELINE_EXIT=%s\n' "$rc" >> "$logf"
    rm -f "$pidf"
  ) &
  local bg_pid=$!
  printf '%s\n' "$bg_pid" > "$pidf"
  disown

  echo ""
  echo "Created spec: $dir  (mode: $mode, running in background, pid $bg_pid)"
  echo "Log:    $logf"
  echo "Follow: tail -f \"$logf\""
  echo "Spec lands at: $dir/plans/SPEC.md"
  echo "When done: acorn spec-complete $repo $slug"
}

cmd_list() {
  local repo=""
  _SHOW_DEPS=0
  _LIST_NWO=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --deps)
        _SHOW_DEPS=1
        ;;
      *)
        repo="$1"
        ;;
    esac
    shift
  done

  require_cmds gh jq
  print_list_header
  if [ -n "$repo" ]; then
    list_specs_for_repo "$repo"
  else
    list_specs_all
  fi

  _SHOW_DEPS=0
  _LIST_NWO=""
}

cmd_status() {
  local repo="${1:-}"
  require_cmds jq
  print_status_header
  if [ -n "$repo" ]; then
    list_status_for_repo "$repo"
  else
    list_status_all
  fi
}

cmd_approve() {
  local repo="$1"
  local slug="$2"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  local dir
  dir="$(spec_dir "$repo" "$slug")"

  [ -d "$dir" ] || die "Spec directory missing: $dir"
  [ -f "$dir/plans/SPEC.md" ] || die "Missing final plan: $dir/plans/SPEC.md"

  local issue_number
  issue_number="$(issue_number_from_slug "$slug")"
  [ -n "$issue_number" ] || die "Cannot infer issue number from slug: $slug"

  set_issue_state_label "$repo_main" "$issue_number" "spec-approved"
  comment_issue "$repo_main" "$issue_number" "Spec approved for implementation: $dir/plans/SPEC.md"

  echo "Approved $slug (issue #$issue_number)"
}

cmd_spec_complete() {
  local repo="$1"
  local slug="$2"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  local dir
  dir="$(spec_dir "$repo" "$slug")"

  [ -d "$dir" ] || die "Spec directory missing: $dir"
  [ -f "$dir/plans/SPEC.md" ] || die "Missing final plan: $dir/plans/SPEC.md"

  local issue_number
  issue_number="$(issue_number_from_slug "$slug")"
  [ -n "$issue_number" ] || die "Cannot infer issue number from slug: $slug"

  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_number" "spec-review"
  comment_issue "$repo_main" "$issue_number" "Spec ready for review: $dir/plans/SPEC.md"

  echo "Marked $slug (issue #$issue_number) as spec-review"
}

cmd_clean() {
  local repo="$1"
  local slug="$2"
  shift 2

  local remove_labels=0
  local yes=0
  local force=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --remove-labels)
        remove_labels=1
        ;;
      --yes)
        yes=1
        ;;
      --force)
        force=1
        ;;
      *)
        die "Unknown option for clean: $1"
        ;;
    esac
    shift
  done

  require_cmds jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local target
  target="$(spec_dir "$repo" "$slug")"
  local root
  root="$(spec_root "$repo")"

  case "$target" in
    "$root"/*) ;;
    *) die "Unsafe clean target path: $target" ;;
  esac

  if [ ! -d "$target" ]; then
    warn "Spec directory missing (already clean): $target"
    return 0
  fi

  # Safety check: refuse to delete specs that haven't been implemented yet
  if [ "$force" -ne 1 ] && [ -f "$target/plans/SPEC.md" ]; then
    local issue_number
    issue_number="$(issue_number_from_slug "$slug")"
    local issue_state="unknown"
    if [ -n "$issue_number" ]; then
      issue_state="$(cd "$repo_main" && gh issue view "$issue_number" --json state -q '.state' 2>/dev/null || printf 'unknown')"
    fi
    if [ "$issue_state" != "CLOSED" ]; then
      warn "Spec has plans/SPEC.md but issue #${issue_number:-?} is still open (state: $issue_state)."
      warn "This spec hasn't been implemented yet. Deleting it would lose the generated spec."
      warn "Use --force to delete anyway, or close the issue first."
      die "Refusing to clean unimplemented spec. Use: acorn clean $repo $slug --force"
    fi
  fi

  if [ "$yes" -ne 1 ]; then
    printf 'Delete spec directory %s ? [y/N] ' "$target"
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *)
        info "Aborted"
        return 0
        ;;
    esac
  fi

  # Stop an in-flight pipeline before deleting its directory, otherwise its
  # agents keep running until they fail on the vanished artifact paths.
  if [ -f "$target/pipeline.pid" ]; then
    local run_pid
    run_pid="$(cat "$target/pipeline.pid" 2>/dev/null || true)"
    if [ -n "$run_pid" ] && kill -0 "$run_pid" 2>/dev/null; then
      info "Stopping running headless pipeline (pid $run_pid)"
      kill "$run_pid" 2>/dev/null || true
    fi
  fi

  rm -rf "$target"
  info "Removed $target"

  if [ "$remove_labels" -eq 1 ]; then
    require_cmds gh
    local issue_number
    issue_number="$(issue_number_from_slug "$slug")"
    if [ -n "$issue_number" ]; then
      local label
      for label in "${LIFECYCLE_LABELS[@]}" "${CLARIFICATION_LABELS[@]}"; do
        remove_issue_label_soft "$repo_main" "$issue_number" "$label"
      done
    else
      warn "Could not infer issue number from slug; skipping label cleanup"
    fi
  fi
}

# Prompt the user interactively for structured issue sections.
# Prints assembled markdown body to stdout.
# Prompts are written to stderr so stdout remains clean for capture.
# All sections are optional — pressing Enter skips a section.
# Returns empty string if all sections are skipped.
build_issue_body_interactive() {
  local job_story="" promise="" constraints="" acceptance="" context=""

  printf '\n' >&2
  printf 'Structured issue template (press Enter to skip any section):\n' >&2
  printf '\n' >&2

  printf 'Job Story (When [situation], I want [action], so I can [outcome]):\n> ' >&2
  IFS= read -r job_story || true

  printf 'Promise (After this ships: [guarantee]):\n> ' >&2
  IFS= read -r promise || true

  printf 'Constraints (what must not change, out of scope):\n> ' >&2
  IFS= read -r constraints || true

  printf 'Acceptance Criteria (specific testable conditions):\n> ' >&2
  IFS= read -r acceptance || true

  printf 'Context (examples, links, prior art — optional):\n> ' >&2
  IFS= read -r context || true

  local body=""
  local has_content=0

  if [ -n "$job_story" ]; then
    body+="## Job Story"$'\n\n'"$job_story"$'\n'
    has_content=1
  fi

  if [ -n "$promise" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Promise"$'\n\n'"$promise"$'\n'
    has_content=1
  fi

  if [ -n "$constraints" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Constraints"$'\n\n'"$constraints"$'\n'
    has_content=1
  fi

  if [ -n "$acceptance" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Acceptance Criteria"$'\n\n'"$acceptance"$'\n'
    has_content=1
  fi

  if [ -n "$context" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Context"$'\n\n'"$context"$'\n'
    has_content=1
  fi

  printf '%s' "$body"
}

create_issue_in_repo() {
  local repo="$1"
  local title="$2"
  shift 2

  require_cmds gh
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local body=""
  local body_file=""
  local labels=()
  local assignees=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --body)
        [ "$#" -ge 2 ] || die "--body requires a value"
        body="$2"
        shift 2
        ;;
      --body-file)
        [ "$#" -ge 2 ] || die "--body-file requires a path"
        body_file="$2"
        shift 2
        ;;
      --label)
        [ "$#" -ge 2 ] || die "--label requires a value"
        labels+=("$2")
        shift 2
        ;;
      --assignee)
        [ "$#" -ge 2 ] || die "--assignee requires a value"
        assignees+=("$2")
        shift 2
        ;;
      *)
        die "Unknown option for issue create/plan: $1"
        ;;
    esac
  done

  if [ -n "$body" ] && [ -n "$body_file" ]; then
    die "Use either --body or --body-file, not both"
  fi

  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || die "Body file not found: $body_file"
    body="$(<"$body_file")"
  fi

  local create_args=(issue create --title "$title")
  if [ -n "$body" ]; then
    create_args+=(--body "$body")
  fi

  local label
  for label in "${labels[@]+"${labels[@]}"}"; do
    create_args+=(--label "$label")
  done

  local assignee
  for assignee in "${assignees[@]+"${assignees[@]}"}"; do
    create_args+=(--assignee "$assignee")
  done

  local out
  out="$(
    cd "$repo_main"
    gh "${create_args[@]}"
  )" || die "Failed to create issue in $repo"

  local issue_num issue_url
  issue_num="$(printf '%s' "$out" | sed -nE 's#.*/issues/([0-9]+)$#\1#p')"
  issue_url="$(printf '%s' "$out" | tail -n1)"

  [ -n "$issue_num" ] || die "Could not parse issue number from gh output: $out"
  printf '%s\n%s\n' "$issue_num" "$issue_url"
}

# Analyze an issue and return structured JSON split recommendation.
# Uses claude -p (one-shot headless) for lightweight AI analysis.
# Prints JSON to stdout. Info/warnings to stderr.
analyze_issue_for_split() {
  local issue_title="$1"
  local issue_body="$2"
  local issue_comments="${3:-}"
  # `sonnet` is an alias that resolves to the latest Sonnet; avoids pinning a
  # generation-stale full ID. Override per-call with `acorn issue split --model`.
  local model="${4:-sonnet}"

  # jq is always needed here; the model's own CLI (claude/codex) is required
  # inside run_agent AFTER resolve_model, so a codex model with codex absent can
  # still soft-fall-back to Claude. Temp files below are cleaned by the EXIT trap
  # even if run_agent dies, so we don't need an up-front CLI check.
  require_cmds jq

  local prompt
  prompt="$(cat <<'SPLIT_PROMPT_EOF'
You are analyzing a GitHub issue to determine whether it should be split into smaller, more focused issues.

Evaluate the issue below. Consider:
1. Does it contain multiple independent concerns or pieces of work?
2. Could parts be implemented and shipped independently?
3. Is it too large for a single atomic implementation?
4. Are there distinct functional areas that would benefit from separate tracking?

An issue should NOT be split if:
- It's already focused on a single concern
- The parts are tightly coupled and can't be implemented independently
- Splitting would create unnecessary overhead for a small issue

Respond with ONLY a JSON object (no markdown fencing, no explanation outside the JSON):
{
  "should_split": true or false,
  "reasoning": "Brief explanation of your assessment",
  "sub_issues": [
    {"title": "Concise sub-issue title", "scope": "1-2 sentence scope description"},
    ...
  ]
}

If should_split is false, sub_issues should be an empty array.
Each sub-issue should be independently implementable and testable.
Aim for 2-5 sub-issues when splitting. Fewer than 2 means it should not be split.
SPLIT_PROMPT_EOF
  )"

  local issue_content="# Issue: ${issue_title}"$'\n\n'"${issue_body}"
  if [ -n "$issue_comments" ]; then
    issue_content+=$'\n\n'"## Discussion"$'\n\n'"${issue_comments}"
  fi

  local full_prompt="${prompt}"$'\n\n'"---"$'\n\n'"${issue_content}"

  printf '[INFO] %s\n' "Analyzing issue for split recommendation (model: $model)..." >&2

  # Structured output: hand run_agent a JSON Schema. On Codex this becomes a
  # hard --output-schema constraint; on Claude it is appended to the prompt and
  # the result is validated. Either way the caller gets clean JSON, no scraping.
  local schema_file out_file
  schema_file="$(mktemp)" || die "Failed to create temp file for schema"
  out_file="$(mktemp)" || { rm -f "$schema_file"; die "Failed to create temp file for output"; }
  # Guarantee cleanup even if run_agent dies (e.g. ACORN_STRICT_PANEL with an
  # unavailable Codex model). Cleared on the normal return path below.
  trap 'rm -f "$schema_file" "$out_file" 2>/dev/null' EXIT
  cat > "$schema_file" <<'SPLIT_SCHEMA_EOF'
{
  "type": "object",
  "additionalProperties": false,
  "required": ["should_split", "reasoning", "sub_issues"],
  "properties": {
    "should_split": { "type": "boolean" },
    "reasoning": { "type": "string" },
    "sub_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "scope"],
        "properties": {
          "title": { "type": "string" },
          "scope": { "type": "string" }
        }
      }
    }
  }
}
SPLIT_SCHEMA_EOF

  if ! printf '%s' "$full_prompt" | run_agent "$model" "$out_file" --format json --schema "$schema_file"; then
    die "Failed to get split analysis (model: $model). See the run_agent error above."
  fi

  local json
  json="$(jq -c . "$out_file" 2>/dev/null)" || die "Split analysis returned unparseable output"
  rm -f "$schema_file" "$out_file"
  trap - EXIT

  # Validate JSON structure using has() to avoid short-circuit on false values
  printf '%s' "$json" | jq -e 'has("should_split") and has("reasoning") and has("sub_issues")' >/dev/null 2>&1 \
    || die "Split analysis returned invalid JSON structure. Got: $json"

  printf '%s' "$json"
}

# Format a split recommendation JSON as human-readable output.
# Prints formatted recommendation to stdout.
format_split_recommendation() {
  local json="$1"
  local parent_issue_number="$2"

  local should_split reasoning
  should_split="$(printf '%s' "$json" | jq -r '.should_split')"
  reasoning="$(printf '%s' "$json" | jq -r '.reasoning')"

  echo ""
  echo "=== Split Analysis for Issue #${parent_issue_number} ==="
  echo ""
  echo "Recommendation: $([ "$should_split" = "true" ] && echo "SPLIT" || echo "DO NOT SPLIT")"
  echo "Reasoning: $reasoning"

  if [ "$should_split" = "true" ]; then
    local count
    count="$(printf '%s' "$json" | jq '.sub_issues | length')"
    echo ""
    echo "Proposed sub-issues ($count):"
    echo ""

    if [ "$count" -gt 0 ]; then
      local i title scope
      for i in $(seq 0 $((count - 1))); do
        title="$(printf '%s' "$json" | jq -r ".sub_issues[$i].title")"
        scope="$(printf '%s' "$json" | jq -r ".sub_issues[$i].scope")"
        echo "  $((i + 1)). $title"
        echo "     Scope: $scope"
        echo ""
      done
    fi
  fi
}

# Create sub-issues from split analysis JSON.
# Prints created issue numbers and URLs to stdout.
# Posts a summary comment on the parent issue.
create_sub_issues() {
  local repo="$1"
  local parent_issue_number="$2"
  local json="$3"

  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local count
  count="$(printf '%s' "$json" | jq '.sub_issues | length')"

  local created_issues=()
  local i title scope sub_body result sub_num sub_url

  if [ "$count" -gt 0 ]; then
    for i in $(seq 0 $((count - 1))); do
      title="$(printf '%s' "$json" | jq -r ".sub_issues[$i].title")"
      scope="$(printf '%s' "$json" | jq -r ".sub_issues[$i].scope")"

      sub_body="## Scope"$'\n\n'"${scope}"$'\n\n'"## Parent Issue"$'\n\n'"Split from #${parent_issue_number} by acorn."

      result="$(create_issue_in_repo "$repo" "$title" --body "$sub_body")" \
        || { warn "Failed to create sub-issue: $title"; continue; }

      sub_num="$(printf '%s' "$result" | sed -n '1p')"
      sub_url="$(printf '%s' "$result" | sed -n '2p')"

      created_issues+=("${sub_num}"$'\t'"${title}"$'\t'"${sub_url}")
      echo "  Created #$sub_num: $title"
      echo "  URL: $sub_url"
      echo ""
    done
  fi

  # Post summary comment on parent issue
  if [ "${#created_issues[@]}" -gt 0 ]; then
    local comment_body="## Issue Split by Acorn"$'\n\n'
    comment_body+="This issue has been split into the following sub-issues:"$'\n\n'

    local entry cnum ctitle
    for entry in "${created_issues[@]}"; do
      cnum="$(printf '%s' "$entry" | cut -d$'\t' -f1)"
      ctitle="$(printf '%s' "$entry" | cut -d$'\t' -f2)"
      comment_body+="- #${cnum} -- ${ctitle}"$'\n'
    done

    comment_body+=$'\n'"Each sub-issue references this parent for traceability."

    comment_issue "$repo_main" "$parent_issue_number" "$comment_body"
    info "Posted split summary comment on issue #$parent_issue_number"
  else
    warn "No sub-issues were created successfully."
  fi
}

cmd_deps_graph() {
  local repo="$1"
  shift

  [ "$#" -ge 1 ] || die "Usage: acorn deps graph <repo> <issue#> [<issue#>...]"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local issues=("$@")
  info "Building dependency graph for ${#issues[@]} issues..."

  local graph
  graph="$(build_dependency_graph "$repo_main" "${issues[@]}")"

  if [ -z "$graph" ]; then
    echo "No issues to process."
    return 0
  fi

  echo ""
  echo "Dependency edges:"
  printf '%s\n' "$graph"

  local wave_output
  wave_output="$(printf '%s\n' "$graph" | topological_sort_waves)"

  echo ""
  echo "Execution plan:"
  local wave_num=0
  local in_wave=0
  local line
  while IFS= read -r line; do
    if [ "$line" = "---" ]; then
      in_wave=0
      continue
    fi
    if [ "$in_wave" -eq 0 ]; then
      wave_num=$((wave_num + 1))
      printf '\nWave %d:\n' "$wave_num"
      in_wave=1
    fi
    printf '  #%s\n' "$line"
  done < <(printf '%s\n' "$wave_output")

  echo ""
  printf 'Total: %d wave(s), %d issue(s)\n' "$wave_num" "${#issues[@]}"
}

cmd_issue_clarify() {
  local repo="$1"
  local issue_number="$2"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  ensure_labels "$repo_main"

  # Transition lifecycle only when still at triage (or unset).
  local labels_json current_lifecycle="" label
  labels_json="$(
    cd "$repo_main"
    gh issue view "$issue_number" --json labels 2>/dev/null | jq -c '.labels // []'
  )" || labels_json='[]'

  for label in "${LIFECYCLE_LABELS[@]}"; do
    if printf '%s' "$labels_json" | jq -e --arg l "$label" '.[] | select(.name == $l)' >/dev/null 2>&1; then
      current_lifecycle="$label"
      break
    fi
  done

  if [ -z "$current_lifecycle" ] || [ "$current_lifecycle" = "triage" ]; then
    set_issue_state_label "$repo_main" "$issue_number" "ready-for-spec"
    echo "Marked issue #$issue_number in $repo as human-clarified and ready-for-spec"
  else
    echo "Marked issue #$issue_number in $repo as human-clarified (lifecycle unchanged: $current_lifecycle)"
  fi

  set_clarification_label "$repo_main" "$issue_number" "human-clarified"
}

cmd_issue_label() {
  local repo="$1"
  local issue_number="$2"
  local target="$3"

  require_cmds gh
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local valid=0
  local label
  for label in "${LIFECYCLE_LABELS[@]}"; do
    if [ "$label" = "$target" ]; then
      valid=1
      break
    fi
  done
  [ "$valid" -eq 1 ] || die "Unknown lifecycle label: $target (valid: ${LIFECYCLE_LABELS[*]})"

  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_number" "$target"

  echo "Set issue #$issue_number in $repo to '$target'"
}

# Analyze an issue and recommend whether it should be split into sub-issues.
# If splitting is recommended and the user accepts, creates the sub-issues
# and posts a reference comment on the parent.
#
# Usage: acorn issue split <repo> <issue-number> [--yes] [--model <model>]
cmd_issue_split() {
  local repo="$1"
  local issue_number="$2"
  shift 2

  local yes=0
  # Default from the panel (honors ACORN_PANEL_split); --model overrides below.
  local model
  model="$(panel_model split)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes)
        yes=1
        ;;
      --model)
        [ "$#" -ge 2 ] || die "--model requires a value"
        [ -n "$2" ] || die "--model requires a non-empty value"
        model="$2"
        shift
        ;;
      *)
        die "Unknown option for issue split: $1"
        ;;
    esac
    shift
  done

  # run_agent requires the model-specific CLI (claude or codex) itself.
  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  # Fetch issue data
  info "Fetching issue #$issue_number from $repo"
  local issue_json
  issue_json="$(gh_issue_json "$repo_main" "$issue_number")" \
    || die "Failed to fetch issue #$issue_number"

  local title body comments_rendered
  title="$(printf '%s' "$issue_json" | jq -r '.title // "Untitled"')"
  body="$(printf '%s' "$issue_json" | jq -r '.body // ""')"

  # Reuse existing render_comments_block for comment formatting
  comments_rendered="$(render_comments_block "$issue_json")"

  # If no comments, render_comments_block returns placeholder text.
  # Pass empty string to analysis when there are no real comments.
  local comment_count
  comment_count="$(printf '%s' "$issue_json" | jq '.comments | length')"
  if [ "$comment_count" -eq 0 ]; then
    comments_rendered=""
  fi

  # Analyze
  local analysis
  analysis="$(analyze_issue_for_split "$title" "$body" "$comments_rendered" "$model")"

  # Display recommendation
  format_split_recommendation "$analysis" "$issue_number"

  # Check if split is recommended
  local should_split
  should_split="$(printf '%s' "$analysis" | jq -r '.should_split')"

  if [ "$should_split" != "true" ]; then
    echo "No split recommended. Proceed with the original issue."
    echo "Next: acorn create $repo $issue_number"
    return 0
  fi

  # Validate sub_issues has at least 2 entries
  local sub_count
  sub_count="$(printf '%s' "$analysis" | jq '.sub_issues | length')"
  if [ "$sub_count" -lt 2 ]; then
    warn "AI recommended split but provided fewer than 2 sub-issues ($sub_count). Treating as no-split."
    echo "No actionable split recommendation. Proceed with the original issue."
    echo "Next: acorn create $repo $issue_number"
    return 0
  fi

  # Confirm with user
  if [ "$yes" -ne 1 ]; then
    if [ ! -t 0 ]; then
      die "Split recommended but running non-interactively. Use --yes to auto-accept."
    fi
    printf 'Create these sub-issues? [y/N] '
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *)
        info "Split rejected. Original issue unchanged."
        return 0
        ;;
    esac
  fi

  # Create sub-issues
  echo ""
  echo "Creating sub-issues..."
  echo ""
  create_sub_issues "$repo" "$issue_number" "$analysis"

  echo "Split complete. Original issue #$issue_number has been annotated."
  echo "Next steps: run 'acorn create $repo <sub-issue#>' for each sub-issue."
}

cmd_issue_depends() {
  local repo="$1"
  local issue_number="$2"
  shift 2

  local add_blocked=()
  local remove_blocked=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --blocked-by)
        [ "$#" -ge 2 ] || die "--blocked-by requires a value"
        IFS=',' read -ra nums <<< "$2"
        add_blocked+=("${nums[@]}")
        shift 2
        ;;
      --remove-blocked-by)
        [ "$#" -ge 2 ] || die "--remove-blocked-by requires a value"
        IFS=',' read -ra nums <<< "$2"
        remove_blocked+=("${nums[@]}")
        shift 2
        ;;
      *)
        die "Unknown option for issue depends: $1"
        ;;
    esac
  done

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"

  local num
  for num in "${remove_blocked[@]+"${remove_blocked[@]}"}"; do
    num="$(printf '%s' "$num" | tr -d '[:space:]')"
    [ -n "$num" ] || continue
    remove_blocked_by_dependency "$repo_main" "$issue_number" "$num" "$nwo" || true
  done

  for num in "${add_blocked[@]+"${add_blocked[@]}"}"; do
    num="$(printf '%s' "$num" | tr -d '[:space:]')"
    [ -n "$num" ] || continue
    if detect_circular_dependency "$repo_main" "$issue_number" "$num" "$nwo"; then
      warn "Circular dependency: #$num -> ... -> #$issue_number. Skipping #$num."
      continue
    fi
    add_blocked_by_dependency "$repo_main" "$issue_number" "$num" "$nwo" || true
  done

  echo ""
  echo "Issue #$issue_number dependencies:"
  echo ""

  echo "Blocked by:"
  local blocked_by_json
  blocked_by_json="$(get_blocked_by "$repo_main" "$issue_number" "$nwo")"
  local bb_count
  bb_count="$(printf '%s' "$blocked_by_json" | jq 'length')"
  if [ "$bb_count" -eq 0 ]; then
    echo "  (none)"
  else
    printf '%s' "$blocked_by_json" | jq -r '.[] | "  #\(.number) \(.title // "untitled") [\(.state // "unknown")]"'
  fi

  echo ""
  echo "Blocks:"
  local blocking_json
  blocking_json="$(get_blocking "$repo_main" "$issue_number" "$nwo")"
  local bl_count
  bl_count="$(printf '%s' "$blocking_json" | jq 'length')"
  if [ "$bl_count" -eq 0 ]; then
    echo "  (none)"
  else
    printf '%s' "$blocking_json" | jq -r '.[] | "  #\(.number) \(.title // "untitled") [\(.state // "unknown")]"'
  fi
}

cmd_issue_create() {
  local repo="$1"
  local title="$2"
  shift 2

  # Separate special flags from args passed to create_issue_in_repo
  local raw=0
  local pass_args=()
  local blocked_by=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --raw)
        raw=1
        shift
        ;;
      --blocked-by)
        [ "$#" -ge 2 ] || die "--blocked-by requires a value"
        IFS=',' read -ra _bb_nums <<< "$2"
        blocked_by+=("${_bb_nums[@]}")
        shift 2
        ;;
      *)
        pass_args+=("$1")
        shift
        ;;
    esac
  done

  # Detect if --body or --body-file was provided
  local has_body=0
  local i
  for i in "${pass_args[@]+"${pass_args[@]}"}"; do
    case "$i" in
      --body|--body-file) has_body=1; break ;;
    esac
  done

  # Interactive template mode: no --raw, no --body, no --body-file, stdin is terminal
  if [ "$raw" -eq 0 ] && [ "$has_body" -eq 0 ] && [ -t 0 ]; then
    local tmpfile
    tmpfile="$(mktemp)" || die "Failed to create temp file"
    build_issue_body_interactive > "$tmpfile"
    local template_body
    template_body="$(<"$tmpfile")"
    rm -f "$tmpfile"
    if [ -n "$template_body" ]; then
      pass_args+=(--body "$template_body")
    fi
  fi

  local result issue_num issue_url
  result="$(create_issue_in_repo "$repo" "$title" "${pass_args[@]+"${pass_args[@]}"}")"
  issue_num="$(printf '%s' "$result" | sed -n '1p')"
  issue_url="$(printf '%s' "$result" | sed -n '2p')"

  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_num" "triage"
  set_clarification_label "$repo_main" "$issue_num" "ai-drafted"

  if [ "${#blocked_by[@]}" -gt 0 ]; then
    add_blocked_by_bulk "$repo_main" "$issue_num" "${blocked_by[@]}"
  fi

  echo "Created issue in $repo"
  echo "Issue: #$issue_num"
  echo "URL: $issue_url"
  echo "Next: acorn create $repo $issue_num"
}

cmd_issue_plan() {
  local repo="$1"
  local title="$2"
  shift 2

  local create_flags=()
  local issue_args=()
  local raw=0
  local blocked_by=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-run|--lite|--quick)
        create_flags+=("$1")
        shift
        ;;
      --raw)
        raw=1
        shift
        ;;
      --blocked-by)
        [ "$#" -ge 2 ] || die "--blocked-by requires a value"
        IFS=',' read -ra _bb_nums <<< "$2"
        blocked_by+=("${_bb_nums[@]}")
        shift 2
        ;;
      *)
        issue_args+=("$1")
        shift
        ;;
    esac
  done

  # Detect if --body or --body-file was provided
  local has_body=0
  local i
  for i in "${issue_args[@]+"${issue_args[@]}"}"; do
    case "$i" in
      --body|--body-file) has_body=1; break ;;
    esac
  done

  # Interactive template mode: no --raw, no --body, no --body-file, stdin is terminal
  if [ "$raw" -eq 0 ] && [ "$has_body" -eq 0 ] && [ -t 0 ]; then
    local tmpfile
    tmpfile="$(mktemp)" || die "Failed to create temp file"
    build_issue_body_interactive > "$tmpfile"
    local template_body
    template_body="$(<"$tmpfile")"
    rm -f "$tmpfile"
    if [ -n "$template_body" ]; then
      issue_args+=(--body "$template_body")
    fi
  fi

  local result issue_num issue_url
  result="$(create_issue_in_repo "$repo" "$title" "${issue_args[@]+"${issue_args[@]}"}")"
  issue_num="$(printf '%s' "$result" | sed -n '1p')"
  issue_url="$(printf '%s' "$result" | sed -n '2p')"

  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  ensure_labels "$repo_main"
  set_clarification_label "$repo_main" "$issue_num" "ai-drafted"

  if [ "${#blocked_by[@]}" -gt 0 ]; then
    add_blocked_by_bulk "$repo_main" "$issue_num" "${blocked_by[@]}"
  fi

  echo "Created issue in $repo"
  echo "Issue: #$issue_num"
  echo "URL: $issue_url"
  echo "Starting spec creation..."
  cmd_create "$repo" "$issue_num" "${create_flags[@]+"${create_flags[@]}"}"
}

main() {
  local cmd="${1:-}"
  local subcmd
  local repo
  local slug
  local title

  case "$cmd" in
    create)
      [ "$#" -ge 3 ] || { usage; exit 1; }
      local _c_repo="$2" _c_issue="$3"
      shift 3
      cmd_create "$_c_repo" "$_c_issue" "$@"
      ;;
    list)
      shift 1
      cmd_list "$@"
      ;;
    status)
      if [ "$#" -gt 2 ]; then
        usage
        exit 1
      fi
      cmd_status "${2:-}"
      ;;
    approve)
      [ "$#" -eq 3 ] || { usage; exit 1; }
      cmd_approve "$2" "$3"
      ;;
    spec-complete)
      [ "$#" -eq 3 ] || { usage; exit 1; }
      cmd_spec_complete "$2" "$3"
      ;;
    clean)
      [ "$#" -ge 3 ] || { usage; exit 1; }
      repo="$2"
      slug="$3"
      shift 3
      cmd_clean "$repo" "$slug" "$@"
      ;;
    deps)
      [ "$#" -ge 2 ] || { usage; exit 1; }
      subcmd="$2"
      case "$subcmd" in
        graph)
          [ "$#" -ge 4 ] || die "Usage: acorn deps graph <repo> <issue#> [<issue#>...]"
          repo="$3"
          shift 3
          cmd_deps_graph "$repo" "$@"
          ;;
        *)
          usage
          die "Unknown deps subcommand: $subcmd"
          ;;
      esac
      ;;
    issue)
      [ "$#" -ge 2 ] || { usage; exit 1; }
      subcmd="$2"
      case "$subcmd" in
        create)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          title="$4"
          shift 4
          cmd_issue_create "$repo" "$title" "$@"
          ;;
        plan)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          title="$4"
          shift 4
          cmd_issue_plan "$repo" "$title" "$@"
          ;;
        clarify)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          local _cl_issue="$4"
          shift 4
          cmd_issue_clarify "$repo" "$_cl_issue"
          ;;
        label)
          [ "$#" -ge 5 ] || { usage; exit 1; }
          repo="$3"
          local _lb_issue="$4"
          local _lb_label="$5"
          shift 5
          cmd_issue_label "$repo" "$_lb_issue" "$_lb_label"
          ;;
        split)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          local _sp_issue="$4"
          shift 4
          cmd_issue_split "$repo" "$_sp_issue" "$@"
          ;;
        depends)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          local _dep_issue="$4"
          shift 4
          cmd_issue_depends "$repo" "$_dep_issue" "$@"
          ;;
        *)
          usage
          die "Unknown issue subcommand: $2"
          ;;
      esac
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      usage
      die "Unknown command: $cmd"
      ;;
  esac
}

main "$@"
