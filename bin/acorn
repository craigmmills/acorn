render_comments_block() {
  local issue_json="$1"
  printf '%s\n' "$issue_json" | jq -r '
    if (.comments | length) == 0 then
      "_No discussion comments yet._"
    else
      .comments[] |
      "### Comment by @\(.author.login // "unknown") on \(.updatedAt // .createdAt // "unknown-time")\n\n\(.body // "")\n"
    end
  '
}

render_prompt_md() {
  local issue_title="$1"
  local issue_body="$2"
  local issue_json="$3"
  local out_tmp="$4"
  local mode="${5:-full}"
  local spec_path="${6:-.}"
  local url_mapping_file="${7:-}"

  # Rewrite image URLs in body if mapping exists
  if [ -n "$url_mapping_file" ] && [ -f "$url_mapping_file" ] && [ -s "$url_mapping_file" ]; then
    issue_body="$(rewrite_image_urls_in_text "$issue_body" "$url_mapping_file")"
  fi

  {
    printf '# Feature Spec: %s\n\n' "$issue_title"
    printf '## Requirements\n\n'
    if [ -n "$issue_body" ]; then
      printf '%s\n\n' "$issue_body"
    else
      printf '_No issue body provided._\n\n'
    fi

    printf '## Discussion / Context\n\n'
    local comments_text
    comments_text="$(render_comments_block "$issue_json")"
    if [ -n "$url_mapping_file" ] && [ -f "$url_mapping_file" ] && [ -s "$url_mapping_file" ]; then
      comments_text="$(rewrite_image_urls_in_text "$comments_text" "$url_mapping_file")"
    fi
    printf '%s' "$comments_text"
    printf '\n---\n\n'
    planning_block "$mode" "$spec_path"
    printf '\n\n---\n\n'
    cat <<'EOF'
## Completion Protocol

When implementation is complete, the implementing agent must:

1. Create or update `DONE.md` in the spec directory.
2. Include the exact test commands run and their outcomes.
3. Summarize file changes and rationale in concise bullet points.
4. List any follow-up risks or deferred work.
EOF
  } > "$out_tmp"
}

validate_prompt_md() {
  local prompt_path="$1"
  grep -q 'PLANNING METHODOLOGY — MANDATORY INSTRUCTIONS' "$prompt_path" || return 1
  return 0
}

get_extension_from_url() {
  local url="$1"
  # Strip query parameters and fragments
  local path="${url%%\?*}"
  path="${path%%#*}"
  # Extract extension
  local ext="${path##*.}"
  # Lowercase
  ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  case "$ext" in
    png|jpg|jpeg|gif|webp|svg) printf '%s' "$ext" ;;
    *) printf 'png' ;;
  esac
}

generate_image_filename() {
  local url="$1"
  local ext
  ext="$(get_extension_from_url "$url")"

  local hash
  if command -v md5 >/dev/null 2>&1; then
    hash="$(printf '%s' "$url" | md5)"
  elif command -v md5sum >/dev/null 2>&1; then
    hash="$(printf '%s' "$url" | md5sum | cut -d' ' -f1)"
  else
    hash="$(printf '%s' "$url" | cksum | cut -d' ' -f1)"
  fi

  printf '%s.%s' "$hash" "$ext"
}

extract_image_urls() {
  local issue_json="$1"

  # Combine body and all comment bodies into a text stream
  local all_text
  all_text="$(printf '%s' "$issue_json" | jq -r '
    [.body // ""] + [(.comments // [])[] | .body // ""]
    | .[]
  ')" || true

  [ -z "$all_text" ] && return 0

  {
    # Strategy 1: Standard image URLs with known extensions
    printf '%s' "$all_text" \
      | grep -oE '!\[[^]]*\]\([^)]+\)' \
      | sed -nE 's/.*\(([^ ")]+).*/\1/p' \
      | grep -iE '\.(png|jpe?g|gif|webp|svg)(\?[^[:space:]]*)?$' \
      || true

    # Strategy 2: GitHub asset UUID URLs (no extension)
    printf '%s' "$all_text" \
      | grep -oE '!\[[^]]*\]\([^)]+\)' \
      | sed -nE 's/.*\(([^ ")]+).*/\1/p' \
      | grep -E '^https://(github\.com/.*/assets/[0-9a-f-]+|private-user-images\.githubusercontent\.com/)' \
      || true
  } | sort -u
}

extract_and_download_images() {
  local issue_json="$1"
  local images_dir="$2"

  require_cmds curl

  local mapping_file
  mapping_file="$(mktemp)"

  mkdir -p "$images_dir"

  local urls
  urls="$(extract_image_urls "$issue_json")"

  if [ -z "$urls" ]; then
    info "No images found in issue" >&2
    printf '%s' "$mapping_file"
    return 0
  fi

  local url count=0 success=0
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    count=$((count + 1))

    local filename
    filename="$(generate_image_filename "$url")"
    local output_path="$images_dir/$filename"
    local relative_path="images/$filename"

    # Skip if already downloaded (idempotent)
    if [ -f "$output_path" ] && [ -s "$output_path" ]; then
      info "Image already exists: $relative_path" >&2
      printf '%s\t%s\n' "$url" "$relative_path" >> "$mapping_file"
      success=$((success + 1))
      continue
    fi

    # Download to temp file first, then move (atomic)
    local tmp_download="$output_path.tmp"
    if curl -fsSL --max-time 30 --retry 2 -o "$tmp_download" "$url" 2>/dev/null; then
      if [ -s "$tmp_download" ]; then
        mv "$tmp_download" "$output_path"
        info "Downloaded: $relative_path" >&2
        printf '%s\t%s\n' "$url" "$relative_path" >> "$mapping_file"
        success=$((success + 1))
      else
        warn "Downloaded file is empty: $url"
        rm -f "$tmp_download"
      fi
    else
      warn "Failed to download image: $url (keeping original URL)"
      rm -f "$tmp_download"
    fi
  done <<< "$urls"

  info "Images: $success/$count downloaded successfully" >&2
  printf '%s' "$mapping_file"
}

rewrite_image_urls_in_text() {
  local text="$1"
  local mapping_file="$2"

  # Return text unchanged if no mapping
  [ -n "$mapping_file" ] && [ -f "$mapping_file" ] && [ -s "$mapping_file" ] || {
    printf '%s' "$text"
    return 0
  }

  local result="$text"
  local original_url local_path
  while IFS=$'\t' read -r original_url local_path; do
    [ -n "$original_url" ] || continue
    # Use bash string replacement -- no sed escaping needed
    result="${result//"$original_url"/$local_path}"
  done < "$mapping_file"

  printf '%s' "$result"
}

start_session() {
  local repo="$1"
  local slug="$2"
  local spec_path="$3"
  local auto_trigger="${4:-0}"
  local session_name
  session_name="$(canonical_session_name "$repo" "$slug")"

  require_cmds tmux claude

  if tmux has-session -t "$session_name" 2>/dev/null; then
    printf '%s\n%s' "tmux" "$session_name"
    return 0
  fi

  tmux new-session -d -s "$session_name" -c "$spec_path"
  if [ "$auto_trigger" -eq 1 ]; then
    tmux send-keys -t "$session_name" "claude --dangerously-skip-permissions" C-m || true
  else
    tmux send-keys -t "$session_name" "claude" C-m || true
  fi
  printf '%s\n%s' "tmux" "$session_name"
}

# Wait for Claude Code to show its input prompt in a tmux session.
# Polls tmux pane content at regular intervals up to a maximum wait time.
# Returns 0 when the prompt is detected, 1 on timeout.
# On timeout the caller should proceed anyway (graceful degradation).
wait_for_claude_ready() {
  local session_name="$1"
  local max_wait="${2:-30}"
  local interval="${3:-2}"
  local elapsed=0

  while [ "$elapsed" -lt "$max_wait" ]; do
    local pane_content
    pane_content="$(tmux capture-pane -t "$session_name" -ep 2>/dev/null || true)"
    # Strip any residual ANSI escape codes. Use an ANSI-C-quoted literal ESC
    # ($'\x1b') so BSD/macOS sed (which doesn't interpret \x1b) sees a real
    # escape byte, not the four characters backslash-x-1-b.
    pane_content="$(printf '%s' "$pane_content" | sed $'s/\x1b\\[[0-9;]*[a-zA-Z]//g')"
    # Check the last few lines for Claude Code's prompt. Use the POSIX
    # [[:space:]] class rather than the GNU-only \s so this matches on BSD grep.
    if printf '%s' "$pane_content" | tail -n5 | grep -qE '>[[:space:]]*$'; then
      return 0
    fi
    sleep "$interval"
    elapsed=$((elapsed + interval))
  done

  return 1
}

# Send auto-trigger message to a claude session once it is ready.
# Waits for Claude Code to show its input prompt, then sends the message.
# Falls back to sending after timeout if prompt is not detected.
send_auto_trigger() {
  local session_name="$1"
  local message="$2"
  (
    # Wait for Claude Code to be ready (up to 30s); proceed on timeout (|| true
    # prevents set -e from killing the subshell when wait_for_claude_ready returns 1)
    wait_for_claude_ready "$session_name" 30 2 || true
    tmux send-keys -t "$session_name" -l "$message"
    sleep 1
    tmux send-keys -t "$session_name" Enter
  ) &
  disown
}

kill_session() {
  local backend="$1"
  local session_name="$2"
  local repo="$3"
  local slug="$4"

  if [ -n "$session_name" ] && command -v tmux >/dev/null 2>&1; then
    if tmux has-session -t "$session_name" 2>/dev/null; then
      tmux kill-session -t "$session_name" >/dev/null 2>&1 || warn "Failed to kill session $session_name"
      return 0
    fi
  fi

  if command -v tmux >/dev/null 2>&1; then
    local candidates
    candidates="$(tmux list-sessions -F '#S' 2>/dev/null | grep -E "(acorn:${repo}:${slug}|${repo}_specs_${slug}_(claude|pi))" || true)"
    if [ -n "$candidates" ]; then
      while IFS= read -r s; do
        [ -n "$s" ] || continue
        tmux kill-session -t "$s" >/dev/null 2>&1 || warn "Failed killing fallback session $s"
      done <<< "$candidates"
    else
      warn "No active session found for $slug"
    fi
  fi
}

session_state() {
  local session_name="$1"
  local has_meta="$2"

  if [ -z "$session_name" ]; then
    printf 'no-session'
    return 0
  fi

  if ! command -v tmux >/dev/null 2>&1; then
    printf 'unknown'
    return 0
  fi

  if tmux has-session -t "$session_name" 2>/dev/null; then
    printf 'running'
  elif [ "$has_meta" -eq 1 ]; then
    printf 'dead'
  else
    printf 'no-session'
  fi
}

attach_command() {
  local session_name="$1"
  local state="$2"

  if [ "$state" = "running" ]; then
    printf 'tmux attach -t %s' "$session_name"
  else
    printf '%s' "—"
  fi
}

write_meta_json() {
  local path="$1"
  local repo="$2"
  local issue_number="$3"
  local issue_title="$4"
  local slug="$5"
  local backend="$6"
  local session_name="$7"
  local mode="${8:-full}"

  local ts
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  jq -n \
    --arg repo "$repo" \
    --argjson issue_number "$issue_number" \
    --arg issue_title "$issue_title" \
    --arg slug "$slug" \
    --arg created_at "$ts" \
    --arg session_backend "$backend" \
    --arg session_name "$session_name" \
    --arg mode "$mode" \
    '{repo:$repo, issue_number:$issue_number, issue_title:$issue_title, slug:$slug, created_at:$created_at, session_backend:$session_backend, session_name:$session_name, mode:$mode}' \
    > "$path"
}

file_mtime_epoch() {
  local path="$1"
  if stat -f '%m' "$path" >/dev/null 2>&1; then
    stat -f '%m' "$path"
  else
    stat -c '%Y' "$path"
  fi
}

human_age() {
  local epoch="$1"
  local now
  now="$(date +%s)"
  local diff=$((now - epoch))
  if [ "$diff" -lt 60 ]; then
    printf '%ss' "$diff"
  elif [ "$diff" -lt 3600 ]; then
    printf '%sm' $((diff / 60))
  elif [ "$diff" -lt 86400 ]; then
    printf '%sh' $((diff / 3600))
  else
    printf '%sd' $((diff / 86400))
  fi
}

status_for_spec() {
  local repo_main="$1"
  local issue_number="$2"
  local spec_path="$3"

  local labels_json='[]'
  if [ -n "$issue_number" ]; then
    labels_json="$(
      cd "$repo_main"
      gh issue view "$issue_number" --json labels 2>/dev/null | jq -c '.labels // []'
    )" || true
  fi

  # Return the actual lifecycle label if present.
  local label found=""
  for label in "${LIFECYCLE_LABELS[@]}"; do
    if printf '%s' "$labels_json" | jq -e --arg l "$label" '.[] | select(.name == $l)' >/dev/null 2>&1; then
      found="$label"
      break
    fi
  done

  if [ -n "$found" ]; then
    printf '%s' "$found"
  else
    # Backward-compatible fallback for older unlabeled issues.
    local final_exists=0
    local prompt_exists=0
    [ -f "$spec_path/plans/SPEC.md" ] && final_exists=1
    [ -f "$spec_path/PROMPT.md" ] && prompt_exists=1

    if [ "$final_exists" -eq 1 ]; then
      printf 'review'
    elif [ "$prompt_exists" -eq 1 ]; then
      printf 'planning'
    else
      printf 'unknown'
    fi
  fi
}

clarification_for_issue() {
  local repo_main="$1"
  local issue_number="$2"

  [ -n "$issue_number" ] || { printf -- '--'; return 0; }

  local labels_json
  labels_json="$(
    cd "$repo_main"
    gh issue view "$issue_number" --json labels 2>/dev/null | jq -c '.labels // []'
  )" || { printf -- '--'; return 0; }

  if printf '%s' "$labels_json" | jq -e '.[] | select(.name == "human-clarified")' >/dev/null 2>&1; then
    printf 'clarified'
  elif printf '%s' "$labels_json" | jq -e '.[] | select(.name == "ai-drafted")' >/dev/null 2>&1; then
    printf 'ai-drafted'
  else
    printf -- '--'
  fi
}

print_list_header() {
  printf '%-16s %-8s %-40s %-18s %-6s %-8s %-11s %-6s %s\n' "repo" "issue" "slug" "status" "mode" "age" "clarify" "deps" "spec_path"
}

print_list_row() {
  local repo="$1"
  local issue="$2"
  local slug="$3"
  local status="$4"
  local mode="$5"
  local age="$6"
  local clarify="$7"
  local deps="$8"
  local path="$9"
  printf '%-16s %-8s %-40s %-18s %-6s %-8s %-11s %-6s %s\n' "$repo" "$issue" "$slug" "$status" "$mode" "$age" "$clarify" "$deps" "$path"
}

print_status_header() {
  printf '%-16s %-42s %-12s %-8s %-18s %s\n' \
    "REPO" "SLUG" "SESSION" "BACKEND" "STATUS" "ATTACH"
}

print_status_row() {
  local repo="$1"
  local slug="$2"
  local session="$3"
  local backend="$4"
  local status="$5"
  local attach="$6"
  printf '%-16s %-42s %-12s %-8s %-18s %s\n' \
    "$repo" "$slug" "$session" "$backend" "$status" "$attach"
}

list_specs_for_repo() {
  local repo="$1"
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local root
  root="$(spec_root "$repo")"
  [ -d "$root" ] || return 0

  local dir
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue
    local slug
    slug="$(basename "$dir")"
    local issue
    issue="$(issue_number_from_slug "$slug")"
    local status
    status="$(status_for_spec "$repo_main" "$issue" "$dir")"
    local clarify
    clarify="$(clarification_for_issue "$repo_main" "$issue")"
    local mode="full"
    if [ -f "$dir/meta.json" ]; then
      mode="$(jq -r '.mode // "full"' "$dir/meta.json" 2>/dev/null || printf 'full')"
    fi
    local age
    age="$(human_age "$(file_mtime_epoch "$dir")")"
    local deps="--"
    if [ "$_SHOW_DEPS" -eq 1 ] && [ -n "$issue" ] && [ "$issue" != "?" ]; then
      local _list_nwo
      _list_nwo="${_LIST_NWO:-}"
      if [ -z "$_list_nwo" ]; then
        _list_nwo="$(gh_repo_nwo "$repo_main" 2>/dev/null || true)"
        _LIST_NWO="$_list_nwo"
      fi
      if [ -n "$_list_nwo" ]; then
        local dep_count
        dep_count="$(blocked_by_count "$repo_main" "$issue" "$_list_nwo" 2>/dev/null || printf '0')"
        if [ "$dep_count" -gt 0 ] 2>/dev/null; then
          deps="$dep_count"
        fi
      fi
    fi
    print_list_row "$repo" "${issue:-?}" "$slug" "$status" "$mode" "$age" "$clarify" "$deps" "$dir"
  done
}

list_specs_all() {
  local main_dir
  for main_dir in "$PROJECTS_DIR"/*/main; do
    [ -d "$main_dir" ] || continue
    local repo
    repo="$(basename "$(dirname "$main_dir")")"
    if [ -d "$main_dir/.specs" ]; then
      list_specs_for_repo "$repo"
    fi
  done
}

list_status_for_repo() {
  local repo="$1"
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local root
  root="$(spec_root "$repo")"
  [ -d "$root" ] || return 0

  local dir
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue

    local slug
    slug="$(basename "$dir")"

    local session_name="" backend="tmux" has_meta=0
    if [ -f "$dir/meta.json" ]; then
      has_meta=1
      session_name="$(jq -r '.session_name // ""' "$dir/meta.json" 2>/dev/null || true)"
      backend="$(jq -r '.session_backend // "tmux"' "$dir/meta.json" 2>/dev/null || true)"
    fi

    [ -n "$backend" ] && [ "$backend" != "null" ] || backend="tmux"

    if [ -z "$session_name" ] || [ "$session_name" = "null" ]; then
      session_name="$(canonical_session_name "$repo" "$slug")"
    fi

    local state
    state="$(session_state "$session_name" "$has_meta")"

    local issue
    issue="$(issue_number_from_slug "$slug")"
    local pipeline_status
    pipeline_status="$(status_for_spec "$repo_main" "$issue" "$dir")"

    local attach
    attach="$(attach_command "$session_name" "$state")"

    local display_slug
    display_slug="$(truncate_str "$slug" 40)"

    print_status_row "$repo" "$display_slug" "$state" "$backend" "$pipeline_status" "$attach"
  done
}

list_status_all() {
  local main_dir
  for main_dir in "$PROJECTS_DIR"/*/main; do
    [ -d "$main_dir" ] || continue
    local repo
    repo="$(basename "$(dirname "$main_dir")")"
    if [ -d "$main_dir/.specs" ]; then
      list_status_for_repo "$repo"
    fi
  done
}

cmd_create() {
  local repo="$1"
  local issue_number="$2"
  shift 2

  local auto_trigger=1
  local mode="full"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-auto)
        auto_trigger=0
        ;;
      --lite)
        [ "$mode" = "full" ] || die "--lite and --quick are mutually exclusive"
        mode="lite"
        ;;
      --quick)
        [ "$mode" = "full" ] || die "--lite and --quick are mutually exclusive"
        mode="quick"
        ;;
      *)
        die "Unknown option for create: $1"
        ;;
    esac
    shift
  done

  require_cmds gh jq tmux claude
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  info "Fetching issue #$issue_number"
  local issue_json
  issue_json="$(gh_issue_json "$repo_main" "$issue_number")" || die "Failed to fetch issue #$issue_number"

  local title body slug root dir
  title="$(printf '%s' "$issue_json" | jq -r '.title // "Untitled issue"')"
  body="$(printf '%s' "$issue_json" | jq -r '.body // ""')"
  slug="$(build_slug "$issue_number" "$title")"
  root="$(spec_root "$repo")"
  dir="$(spec_dir "$repo" "$slug")"

  mkdir -p "$dir/plans"
  mkdir -p "$dir/recon"
  mkdir -p "$dir/images"

  local prompt_path="$dir/PROMPT.md"
  if [ ! -f "$prompt_path" ]; then
    # Extract and download images from issue markdown
    info "Extracting images from issue #$issue_number"
    local url_mapping_file
    url_mapping_file="$(extract_and_download_images "$issue_json" "$dir/images")"

    local tmp_path="$prompt_path.tmp"
    render_prompt_md "$title" "$body" "$issue_json" "$tmp_path" "$mode" "$dir" "$url_mapping_file"
    if ! validate_prompt_md "$tmp_path"; then
      rm -f "$tmp_path"
      rm -f "$url_mapping_file"
      die "Prompt generation failed: planning anchor missing"
    fi
    mv "$tmp_path" "$prompt_path"
    rm -f "$url_mapping_file"
    info "Generated $prompt_path"
  else
    info "PROMPT.md already exists, leaving as-is"
  fi

  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_number" "spec-in-progress"

  comment_issue "$repo_main" "$issue_number" "Spec started locally at: $dir"

  local session_name
  local meta_path="$dir/meta.json"
  session_name=""

  if [ -f "$meta_path" ]; then
    session_name="$(jq -r '.session_name // ""' "$meta_path" 2>/dev/null || true)"
  fi

  local alive=0
  local started_new_session=0
  if [ -n "$session_name" ] && command -v tmux >/dev/null 2>&1; then
    if tmux has-session -t "$session_name" 2>/dev/null; then
      alive=1
    fi
  fi

  if [ "$alive" -eq 0 ]; then
    local session_result
    session_result="$(start_session "$repo" "$slug" "$dir" "$auto_trigger")"
    session_name="$(printf '%s' "$session_result" | tail -n1)"
    started_new_session=1

    if [ "$auto_trigger" -eq 1 ]; then
      send_auto_trigger "$session_name" "$(auto_trigger_message "$dir" "$mode")"
      info "Auto-trigger queued (waiting for readiness, up to ~30s)"
    fi
  fi

  write_meta_json "$meta_path" "$repo" "$issue_number" "$title" "$slug" "tmux" "$session_name" "$mode"

  echo ""
  echo "Created spec: $dir"
  echo "Mode: $mode"
  echo "Session: $session_name"
  echo "Attach: tmux attach -t $session_name"
  if [ "$auto_trigger" -eq 1 ]; then
    if [ "$started_new_session" -eq 1 ]; then
      echo "Auto-trigger: waiting for Claude Code to be ready (up to ~30s)"
    else
      echo "Auto-trigger: skipped (session already running)"
    fi
  else
    echo "Auto-trigger: disabled (--no-auto)"
    echo "Manual trigger: say \"let's draft this\" in the planning session"
  fi
}

cmd_list() {
  local repo=""
  _SHOW_DEPS=0
  _LIST_NWO=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --deps)
        _SHOW_DEPS=1
        ;;
      *)
        repo="$1"
        ;;
    esac
    shift
  done

  require_cmds gh jq
  print_list_header
  if [ -n "$repo" ]; then
    list_specs_for_repo "$repo"
  else
    list_specs_all
  fi

  _SHOW_DEPS=0
  _LIST_NWO=""
}

cmd_status() {
  local repo="${1:-}"
  require_cmds jq
  print_status_header
  if [ -n "$repo" ]; then
    list_status_for_repo "$repo"
  else
    list_status_all
  fi
}

cmd_approve() {
  local repo="$1"
  local slug="$2"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  local dir
  dir="$(spec_dir "$repo" "$slug")"

  [ -d "$dir" ] || die "Spec directory missing: $dir"
  [ -f "$dir/plans/SPEC.md" ] || die "Missing final plan: $dir/plans/SPEC.md"

  local issue_number
  issue_number="$(issue_number_from_slug "$slug")"
  [ -n "$issue_number" ] || die "Cannot infer issue number from slug: $slug"

  set_issue_state_label "$repo_main" "$issue_number" "spec-approved"
  comment_issue "$repo_main" "$issue_number" "Spec approved for implementation: $dir/plans/SPEC.md"

  echo "Approved $slug (issue #$issue_number)"
}

cmd_spec_complete() {
  local repo="$1"
  local slug="$2"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  local dir
  dir="$(spec_dir "$repo" "$slug")"

  [ -d "$dir" ] || die "Spec directory missing: $dir"
  [ -f "$dir/plans/SPEC.md" ] || die "Missing final plan: $dir/plans/SPEC.md"

  local issue_number
  issue_number="$(issue_number_from_slug "$slug")"
  [ -n "$issue_number" ] || die "Cannot infer issue number from slug: $slug"

  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_number" "spec-review"
  comment_issue "$repo_main" "$issue_number" "Spec ready for review: $dir/plans/SPEC.md"

  echo "Marked $slug (issue #$issue_number) as spec-review"
}

cmd_clean() {
  local repo="$1"
  local slug="$2"
  shift 2

  local remove_labels=0
  local yes=0
  local force=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --remove-labels)
        remove_labels=1
        ;;
      --yes)
        yes=1
        ;;
      --force)
        force=1
        ;;
      *)
        die "Unknown option for clean: $1"
        ;;
    esac
    shift
  done

  require_cmds jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local target
  target="$(spec_dir "$repo" "$slug")"
  local root
  root="$(spec_root "$repo")"

  case "$target" in
    "$root"/*) ;;
    *) die "Unsafe clean target path: $target" ;;
  esac

  if [ ! -d "$target" ]; then
    warn "Spec directory missing (already clean): $target"
    return 0
  fi

  # Safety check: refuse to delete specs that haven't been implemented yet
  if [ "$force" -ne 1 ] && [ -f "$target/plans/SPEC.md" ]; then
    local issue_number
    issue_number="$(issue_number_from_slug "$slug")"
    local issue_state="unknown"
    if [ -n "$issue_number" ]; then
      issue_state="$(cd "$repo_main" && gh issue view "$issue_number" --json state -q '.state' 2>/dev/null || printf 'unknown')"
    fi
    if [ "$issue_state" != "CLOSED" ]; then
      warn "Spec has plans/SPEC.md but issue #${issue_number:-?} is still open (state: $issue_state)."
      warn "This spec hasn't been implemented yet. Deleting it would lose the generated spec."
      warn "Use --force to delete anyway, or close the issue first."
      die "Refusing to clean unimplemented spec. Use: acorn clean $repo $slug --force"
    fi
  fi

  if [ "$yes" -ne 1 ]; then
    printf 'Delete spec directory %s ? [y/N] ' "$target"
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *)
        info "Aborted"
        return 0
        ;;
    esac
  fi

  local backend="" session_name=""
  if [ -f "$target/meta.json" ]; then
    backend="$(jq -r '.session_backend // ""' "$target/meta.json" 2>/dev/null || true)"
    session_name="$(jq -r '.session_name // ""' "$target/meta.json" 2>/dev/null || true)"
  fi

  kill_session "$backend" "$session_name" "$repo" "$slug"

  rm -rf "$target"
  info "Removed $target"

  if [ "$remove_labels" -eq 1 ]; then
    require_cmds gh
    local issue_number
    issue_number="$(issue_number_from_slug "$slug")"
    if [ -n "$issue_number" ]; then
      local label
      for label in "${LIFECYCLE_LABELS[@]}" "${CLARIFICATION_LABELS[@]}"; do
        remove_issue_label_soft "$repo_main" "$issue_number" "$label"
      done
    else
      warn "Could not infer issue number from slug; skipping label cleanup"
    fi
  fi
}

# Prompt the user interactively for structured issue sections.
# Prints assembled markdown body to stdout.
# Prompts are written to stderr so stdout remains clean for capture.
# All sections are optional — pressing Enter skips a section.
# Returns empty string if all sections are skipped.
build_issue_body_interactive() {
  local job_story="" promise="" constraints="" acceptance="" context=""

  printf '\n' >&2
  printf 'Structured issue template (press Enter to skip any section):\n' >&2
  printf '\n' >&2

  printf 'Job Story (When [situation], I want [action], so I can [outcome]):\n> ' >&2
  IFS= read -r job_story || true

  printf 'Promise (After this ships: [guarantee]):\n> ' >&2
  IFS= read -r promise || true

  printf 'Constraints (what must not change, out of scope):\n> ' >&2
  IFS= read -r constraints || true

  printf 'Acceptance Criteria (specific testable conditions):\n> ' >&2
  IFS= read -r acceptance || true

  printf 'Context (examples, links, prior art — optional):\n> ' >&2
  IFS= read -r context || true

  local body=""
  local has_content=0

  if [ -n "$job_story" ]; then
    body+="## Job Story"$'\n\n'"$job_story"$'\n'
    has_content=1
  fi

  if [ -n "$promise" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Promise"$'\n\n'"$promise"$'\n'
    has_content=1
  fi

  if [ -n "$constraints" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Constraints"$'\n\n'"$constraints"$'\n'
    has_content=1
  fi

  if [ -n "$acceptance" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Acceptance Criteria"$'\n\n'"$acceptance"$'\n'
    has_content=1
  fi

  if [ -n "$context" ]; then
    [ "$has_content" -eq 1 ] && body+=$'\n'
    body+="## Context"$'\n\n'"$context"$'\n'
    has_content=1
  fi

  printf '%s' "$body"
}

create_issue_in_repo() {
  local repo="$1"
  local title="$2"
  shift 2

  require_cmds gh
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local body=""
  local body_file=""
  local labels=()
  local assignees=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --body)
        [ "$#" -ge 2 ] || die "--body requires a value"
        body="$2"
        shift 2
        ;;
      --body-file)
        [ "$#" -ge 2 ] || die "--body-file requires a path"
        body_file="$2"
        shift 2
        ;;
      --label)
        [ "$#" -ge 2 ] || die "--label requires a value"
        labels+=("$2")
        shift 2
        ;;
      --assignee)
        [ "$#" -ge 2 ] || die "--assignee requires a value"
        assignees+=("$2")
        shift 2
        ;;
      *)
        die "Unknown option for issue create/plan: $1"
        ;;
    esac
  done

  if [ -n "$body" ] && [ -n "$body_file" ]; then
    die "Use either --body or --body-file, not both"
  fi

  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || die "Body file not found: $body_file"
    body="$(<"$body_file")"
  fi

  local create_args=(issue create --title "$title")
  if [ -n "$body" ]; then
    create_args+=(--body "$body")
  fi

  local label
  for label in "${labels[@]+"${labels[@]}"}"; do
    create_args+=(--label "$label")
  done

  local assignee
  for assignee in "${assignees[@]+"${assignees[@]}"}"; do
    create_args+=(--assignee "$assignee")
  done

  local out
  out="$(
    cd "$repo_main"
    gh "${create_args[@]}"
  )" || die "Failed to create issue in $repo"

  local issue_num issue_url
  issue_num="$(printf '%s' "$out" | sed -nE 's#.*/issues/([0-9]+)$#\1#p')"
  issue_url="$(printf '%s' "$out" | tail -n1)"

  [ -n "$issue_num" ] || die "Could not parse issue number from gh output: $out"
  printf '%s\n%s\n' "$issue_num" "$issue_url"
}

# Analyze an issue and return structured JSON split recommendation.
# Uses claude -p (one-shot headless) for lightweight AI analysis.
# Prints JSON to stdout. Info/warnings to stderr.
analyze_issue_for_split() {
  local issue_title="$1"
  local issue_body="$2"
  local issue_comments="${3:-}"
  # `sonnet` is an alias that resolves to the latest Sonnet; avoids pinning a
  # generation-stale full ID. Override per-call with `acorn issue split --model`.
  local model="${4:-sonnet}"

  local prompt
  prompt="$(cat <<'SPLIT_PROMPT_EOF'
You are analyzing a GitHub issue to determine whether it should be split into smaller, more focused issues.

Evaluate the issue below. Consider:
1. Does it contain multiple independent concerns or pieces of work?
2. Could parts be implemented and shipped independently?
3. Is it too large for a single atomic implementation?
4. Are there distinct functional areas that would benefit from separate tracking?

An issue should NOT be split if:
- It's already focused on a single concern
- The parts are tightly coupled and can't be implemented independently
- Splitting would create unnecessary overhead for a small issue

Respond with ONLY a JSON object (no markdown fencing, no explanation outside the JSON):
{
  "should_split": true or false,
  "reasoning": "Brief explanation of your assessment",
  "sub_issues": [
    {"title": "Concise sub-issue title", "scope": "1-2 sentence scope description"},
    ...
  ]
}

If should_split is false, sub_issues should be an empty array.
Each sub-issue should be independently implementable and testable.
Aim for 2-5 sub-issues when splitting. Fewer than 2 means it should not be split.
SPLIT_PROMPT_EOF
  )"

  local issue_content="# Issue: ${issue_title}"$'\n\n'"${issue_body}"
  if [ -n "$issue_comments" ]; then
    issue_content+=$'\n\n'"## Discussion"$'\n\n'"${issue_comments}"
  fi

  local full_prompt="${prompt}"$'\n\n'"---"$'\n\n'"${issue_content}"

  printf '[INFO] %s\n' "Analyzing issue for split recommendation (model: $model)..." >&2

  # Structured output: hand run_agent a JSON Schema. On Codex this becomes a
  # hard --output-schema constraint; on Claude it is appended to the prompt and
  # the result is validated. Either way the caller gets clean JSON, no scraping.
  local schema_file out_file
  schema_file="$(mktemp)" || die "Failed to create temp file for schema"
  out_file="$(mktemp)" || { rm -f "$schema_file"; die "Failed to create temp file for output"; }
  cat > "$schema_file" <<'SPLIT_SCHEMA_EOF'
{
  "type": "object",
  "additionalProperties": false,
  "required": ["should_split", "reasoning", "sub_issues"],
  "properties": {
    "should_split": { "type": "boolean" },
    "reasoning": { "type": "string" },
    "sub_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "scope"],
        "properties": {
          "title": { "type": "string" },
          "scope": { "type": "string" }
        }
      }
    }
  }
}
SPLIT_SCHEMA_EOF

  if ! printf '%s' "$full_prompt" | run_agent "$model" "$out_file" --format json --schema "$schema_file"; then
    rm -f "$schema_file" "$out_file"
    die "Failed to get split analysis (model: $model). Is the model CLI installed and authenticated?"
  fi

  local json
  json="$(jq -c . "$out_file" 2>/dev/null)" || { rm -f "$schema_file" "$out_file"; die "Split analysis returned unparseable output"; }
  rm -f "$schema_file" "$out_file"

  # Validate JSON structure using has() to avoid short-circuit on false values
  printf '%s' "$json" | jq -e 'has("should_split") and has("reasoning") and has("sub_issues")' >/dev/null 2>&1 \
    || die "Split analysis returned invalid JSON structure. Got: $json"

  printf '%s' "$json"
}

# Format a split recommendation JSON as human-readable output.
# Prints formatted recommendation to stdout.
format_split_recommendation() {
  local json="$1"
  local parent_issue_number="$2"

  local should_split reasoning
  should_split="$(printf '%s' "$json" | jq -r '.should_split')"
  reasoning="$(printf '%s' "$json" | jq -r '.reasoning')"

  echo ""
  echo "=== Split Analysis for Issue #${parent_issue_number} ==="
  echo ""
  echo "Recommendation: $([ "$should_split" = "true" ] && echo "SPLIT" || echo "DO NOT SPLIT")"
  echo "Reasoning: $reasoning"

  if [ "$should_split" = "true" ]; then
    local count
    count="$(printf '%s' "$json" | jq '.sub_issues | length')"
    echo ""
    echo "Proposed sub-issues ($count):"
    echo ""

    if [ "$count" -gt 0 ]; then
      local i title scope
      for i in $(seq 0 $((count - 1))); do
        title="$(printf '%s' "$json" | jq -r ".sub_issues[$i].title")"
        scope="$(printf '%s' "$json" | jq -r ".sub_issues[$i].scope")"
        echo "  $((i + 1)). $title"
        echo "     Scope: $scope"
        echo ""
      done
    fi
  fi
}

# Create sub-issues from split analysis JSON.
# Prints created issue numbers and URLs to stdout.
# Posts a summary comment on the parent issue.
create_sub_issues() {
  local repo="$1"
  local parent_issue_number="$2"
  local json="$3"

  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local count
  count="$(printf '%s' "$json" | jq '.sub_issues | length')"

  local created_issues=()
  local i title scope sub_body result sub_num sub_url

  if [ "$count" -gt 0 ]; then
    for i in $(seq 0 $((count - 1))); do
      title="$(printf '%s' "$json" | jq -r ".sub_issues[$i].title")"
      scope="$(printf '%s' "$json" | jq -r ".sub_issues[$i].scope")"

      sub_body="## Scope"$'\n\n'"${scope}"$'\n\n'"## Parent Issue"$'\n\n'"Split from #${parent_issue_number} by acorn."

      result="$(create_issue_in_repo "$repo" "$title" --body "$sub_body")" \
        || { warn "Failed to create sub-issue: $title"; continue; }

      sub_num="$(printf '%s' "$result" | sed -n '1p')"
      sub_url="$(printf '%s' "$result" | sed -n '2p')"

      created_issues+=("${sub_num}"$'\t'"${title}"$'\t'"${sub_url}")
      echo "  Created #$sub_num: $title"
      echo "  URL: $sub_url"
      echo ""
    done
  fi

  # Post summary comment on parent issue
  if [ "${#created_issues[@]}" -gt 0 ]; then
    local comment_body="## Issue Split by Acorn"$'\n\n'
    comment_body+="This issue has been split into the following sub-issues:"$'\n\n'

    local entry cnum ctitle
    for entry in "${created_issues[@]}"; do
      cnum="$(printf '%s' "$entry" | cut -d$'\t' -f1)"
      ctitle="$(printf '%s' "$entry" | cut -d$'\t' -f2)"
      comment_body+="- #${cnum} -- ${ctitle}"$'\n'
    done

    comment_body+=$'\n'"Each sub-issue references this parent for traceability."

    comment_issue "$repo_main" "$parent_issue_number" "$comment_body"
    info "Posted split summary comment on issue #$parent_issue_number"
  else
    warn "No sub-issues were created successfully."
  fi
}

cmd_deps_graph() {
  local repo="$1"
  shift

  [ "$#" -ge 1 ] || die "Usage: acorn deps graph <repo> <issue#> [<issue#>...]"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local issues=("$@")
  info "Building dependency graph for ${#issues[@]} issues..."

  local graph
  graph="$(build_dependency_graph "$repo_main" "${issues[@]}")"

  if [ -z "$graph" ]; then
    echo "No issues to process."
    return 0
  fi

  echo ""
  echo "Dependency edges:"
  printf '%s\n' "$graph"

  local wave_output
  wave_output="$(printf '%s\n' "$graph" | topological_sort_waves)"

  echo ""
  echo "Execution plan:"
  local wave_num=0
  local in_wave=0
  local line
  while IFS= read -r line; do
    if [ "$line" = "---" ]; then
      in_wave=0
      continue
    fi
    if [ "$in_wave" -eq 0 ]; then
      wave_num=$((wave_num + 1))
      printf '\nWave %d:\n' "$wave_num"
      in_wave=1
    fi
    printf '  #%s\n' "$line"
  done < <(printf '%s\n' "$wave_output")

  echo ""
  printf 'Total: %d wave(s), %d issue(s)\n' "$wave_num" "${#issues[@]}"
}

cmd_issue_clarify() {
  local repo="$1"
  local issue_number="$2"

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  ensure_labels "$repo_main"

  # Transition lifecycle only when still at triage (or unset).
  local labels_json current_lifecycle="" label
  labels_json="$(
    cd "$repo_main"
    gh issue view "$issue_number" --json labels 2>/dev/null | jq -c '.labels // []'
  )" || labels_json='[]'

  for label in "${LIFECYCLE_LABELS[@]}"; do
    if printf '%s' "$labels_json" | jq -e --arg l "$label" '.[] | select(.name == $l)' >/dev/null 2>&1; then
      current_lifecycle="$label"
      break
    fi
  done

  if [ -z "$current_lifecycle" ] || [ "$current_lifecycle" = "triage" ]; then
    set_issue_state_label "$repo_main" "$issue_number" "ready-for-spec"
    echo "Marked issue #$issue_number in $repo as human-clarified and ready-for-spec"
  else
    echo "Marked issue #$issue_number in $repo as human-clarified (lifecycle unchanged: $current_lifecycle)"
  fi

  set_clarification_label "$repo_main" "$issue_number" "human-clarified"
}

cmd_issue_label() {
  local repo="$1"
  local issue_number="$2"
  local target="$3"

  require_cmds gh
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  local valid=0
  local label
  for label in "${LIFECYCLE_LABELS[@]}"; do
    if [ "$label" = "$target" ]; then
      valid=1
      break
    fi
  done
  [ "$valid" -eq 1 ] || die "Unknown lifecycle label: $target (valid: ${LIFECYCLE_LABELS[*]})"

  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_number" "$target"

  echo "Set issue #$issue_number in $repo to '$target'"
}

# Analyze an issue and recommend whether it should be split into sub-issues.
# If splitting is recommended and the user accepts, creates the sub-issues
# and posts a reference comment on the parent.
#
# Usage: acorn issue split <repo> <issue-number> [--yes] [--model <model>]
cmd_issue_split() {
  local repo="$1"
  local issue_number="$2"
  shift 2

  local yes=0
  local model="sonnet"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes)
        yes=1
        ;;
      --model)
        [ "$#" -ge 2 ] || die "--model requires a value"
        [ -n "$2" ] || die "--model requires a non-empty value"
        model="$2"
        shift
        ;;
      *)
        die "Unknown option for issue split: $1"
        ;;
    esac
    shift
  done

  # run_agent requires the model-specific CLI (claude or codex) itself.
  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"

  # Fetch issue data
  info "Fetching issue #$issue_number from $repo"
  local issue_json
  issue_json="$(gh_issue_json "$repo_main" "$issue_number")" \
    || die "Failed to fetch issue #$issue_number"

  local title body comments_rendered
  title="$(printf '%s' "$issue_json" | jq -r '.title // "Untitled"')"
  body="$(printf '%s' "$issue_json" | jq -r '.body // ""')"

  # Reuse existing render_comments_block for comment formatting
  comments_rendered="$(render_comments_block "$issue_json")"

  # If no comments, render_comments_block returns placeholder text.
  # Pass empty string to analysis when there are no real comments.
  local comment_count
  comment_count="$(printf '%s' "$issue_json" | jq '.comments | length')"
  if [ "$comment_count" -eq 0 ]; then
    comments_rendered=""
  fi

  # Analyze
  local analysis
  analysis="$(analyze_issue_for_split "$title" "$body" "$comments_rendered" "$model")"

  # Display recommendation
  format_split_recommendation "$analysis" "$issue_number"

  # Check if split is recommended
  local should_split
  should_split="$(printf '%s' "$analysis" | jq -r '.should_split')"

  if [ "$should_split" != "true" ]; then
    echo "No split recommended. Proceed with the original issue."
    echo "Next: acorn create $repo $issue_number"
    return 0
  fi

  # Validate sub_issues has at least 2 entries
  local sub_count
  sub_count="$(printf '%s' "$analysis" | jq '.sub_issues | length')"
  if [ "$sub_count" -lt 2 ]; then
    warn "AI recommended split but provided fewer than 2 sub-issues ($sub_count). Treating as no-split."
    echo "No actionable split recommendation. Proceed with the original issue."
    echo "Next: acorn create $repo $issue_number"
    return 0
  fi

  # Confirm with user
  if [ "$yes" -ne 1 ]; then
    if [ ! -t 0 ]; then
      die "Split recommended but running non-interactively. Use --yes to auto-accept."
    fi
    printf 'Create these sub-issues? [y/N] '
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *)
        info "Split rejected. Original issue unchanged."
        return 0
        ;;
    esac
  fi

  # Create sub-issues
  echo ""
  echo "Creating sub-issues..."
  echo ""
  create_sub_issues "$repo" "$issue_number" "$analysis"

  echo "Split complete. Original issue #$issue_number has been annotated."
  echo "Next steps: run 'acorn create $repo <sub-issue#>' for each sub-issue."
}

cmd_issue_depends() {
  local repo="$1"
  local issue_number="$2"
  shift 2

  local add_blocked=()
  local remove_blocked=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --blocked-by)
        [ "$#" -ge 2 ] || die "--blocked-by requires a value"
        IFS=',' read -ra nums <<< "$2"
        add_blocked+=("${nums[@]}")
        shift 2
        ;;
      --remove-blocked-by)
        [ "$#" -ge 2 ] || die "--remove-blocked-by requires a value"
        IFS=',' read -ra nums <<< "$2"
        remove_blocked+=("${nums[@]}")
        shift 2
        ;;
      *)
        die "Unknown option for issue depends: $1"
        ;;
    esac
  done

  require_cmds gh jq
  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"

  local num
  for num in "${remove_blocked[@]+"${remove_blocked[@]}"}"; do
    num="$(printf '%s' "$num" | tr -d '[:space:]')"
    [ -n "$num" ] || continue
    remove_blocked_by_dependency "$repo_main" "$issue_number" "$num" "$nwo" || true
  done

  for num in "${add_blocked[@]+"${add_blocked[@]}"}"; do
    num="$(printf '%s' "$num" | tr -d '[:space:]')"
    [ -n "$num" ] || continue
    if detect_circular_dependency "$repo_main" "$issue_number" "$num" "$nwo"; then
      warn "Circular dependency: #$num -> ... -> #$issue_number. Skipping #$num."
      continue
    fi
    add_blocked_by_dependency "$repo_main" "$issue_number" "$num" "$nwo" || true
  done

  echo ""
  echo "Issue #$issue_number dependencies:"
  echo ""

  echo "Blocked by:"
  local blocked_by_json
  blocked_by_json="$(get_blocked_by "$repo_main" "$issue_number" "$nwo")"
  local bb_count
  bb_count="$(printf '%s' "$blocked_by_json" | jq 'length')"
  if [ "$bb_count" -eq 0 ]; then
    echo "  (none)"
  else
    printf '%s' "$blocked_by_json" | jq -r '.[] | "  #\(.number) \(.title // "untitled") [\(.state // "unknown")]"'
  fi

  echo ""
  echo "Blocks:"
  local blocking_json
  blocking_json="$(get_blocking "$repo_main" "$issue_number" "$nwo")"
  local bl_count
  bl_count="$(printf '%s' "$blocking_json" | jq 'length')"
  if [ "$bl_count" -eq 0 ]; then
    echo "  (none)"
  else
    printf '%s' "$blocking_json" | jq -r '.[] | "  #\(.number) \(.title // "untitled") [\(.state // "unknown")]"'
  fi
}

cmd_issue_create() {
  local repo="$1"
  local title="$2"
  shift 2

  # Separate special flags from args passed to create_issue_in_repo
  local raw=0
  local pass_args=()
  local blocked_by=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --raw)
        raw=1
        shift
        ;;
      --blocked-by)
        [ "$#" -ge 2 ] || die "--blocked-by requires a value"
        IFS=',' read -ra _bb_nums <<< "$2"
        blocked_by+=("${_bb_nums[@]}")
        shift 2
        ;;
      *)
        pass_args+=("$1")
        shift
        ;;
    esac
  done

  # Detect if --body or --body-file was provided
  local has_body=0
  local i
  for i in "${pass_args[@]+"${pass_args[@]}"}"; do
    case "$i" in
      --body|--body-file) has_body=1; break ;;
    esac
  done

  # Interactive template mode: no --raw, no --body, no --body-file, stdin is terminal
  if [ "$raw" -eq 0 ] && [ "$has_body" -eq 0 ] && [ -t 0 ]; then
    local tmpfile
    tmpfile="$(mktemp)" || die "Failed to create temp file"
    build_issue_body_interactive > "$tmpfile"
    local template_body
    template_body="$(<"$tmpfile")"
    rm -f "$tmpfile"
    if [ -n "$template_body" ]; then
      pass_args+=(--body "$template_body")
    fi
  fi

  local result issue_num issue_url
  result="$(create_issue_in_repo "$repo" "$title" "${pass_args[@]+"${pass_args[@]}"}")"
  issue_num="$(printf '%s' "$result" | sed -n '1p')"
  issue_url="$(printf '%s' "$result" | sed -n '2p')"

  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  ensure_labels "$repo_main"
  set_issue_state_label "$repo_main" "$issue_num" "triage"
  set_clarification_label "$repo_main" "$issue_num" "ai-drafted"

  if [ "${#blocked_by[@]}" -gt 0 ]; then
    add_blocked_by_bulk "$repo_main" "$issue_num" "${blocked_by[@]}"
  fi

  echo "Created issue in $repo"
  echo "Issue: #$issue_num"
  echo "URL: $issue_url"
  echo "Next: acorn create $repo $issue_num"
}

cmd_issue_plan() {
  local repo="$1"
  local title="$2"
  shift 2

  local create_flags=()
  local issue_args=()
  local raw=0
  local blocked_by=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-auto|--lite|--quick)
        create_flags+=("$1")
        shift
        ;;
      --raw)
        raw=1
        shift
        ;;
      --blocked-by)
        [ "$#" -ge 2 ] || die "--blocked-by requires a value"
        IFS=',' read -ra _bb_nums <<< "$2"
        blocked_by+=("${_bb_nums[@]}")
        shift 2
        ;;
      *)
        issue_args+=("$1")
        shift
        ;;
    esac
  done

  # Detect if --body or --body-file was provided
  local has_body=0
  local i
  for i in "${issue_args[@]+"${issue_args[@]}"}"; do
    case "$i" in
      --body|--body-file) has_body=1; break ;;
    esac
  done

  # Interactive template mode: no --raw, no --body, no --body-file, stdin is terminal
  if [ "$raw" -eq 0 ] && [ "$has_body" -eq 0 ] && [ -t 0 ]; then
    local tmpfile
    tmpfile="$(mktemp)" || die "Failed to create temp file"
    build_issue_body_interactive > "$tmpfile"
    local template_body
    template_body="$(<"$tmpfile")"
    rm -f "$tmpfile"
    if [ -n "$template_body" ]; then
      issue_args+=(--body "$template_body")
    fi
  fi

  local result issue_num issue_url
  result="$(create_issue_in_repo "$repo" "$title" "${issue_args[@]+"${issue_args[@]}"}")"
  issue_num="$(printf '%s' "$result" | sed -n '1p')"
  issue_url="$(printf '%s' "$result" | sed -n '2p')"

  local repo_main
  repo_main="$(safe_repo_main "$repo")"
  ensure_labels "$repo_main"
  set_clarification_label "$repo_main" "$issue_num" "ai-drafted"

  if [ "${#blocked_by[@]}" -gt 0 ]; then
    add_blocked_by_bulk "$repo_main" "$issue_num" "${blocked_by[@]}"
  fi

  echo "Created issue in $repo"
  echo "Issue: #$issue_num"
  echo "URL: $issue_url"
  echo "Starting spec creation..."
  cmd_create "$repo" "$issue_num" "${create_flags[@]+"${create_flags[@]}"}"
}

main() {
  local cmd="${1:-}"
  local subcmd
  local repo
  local slug
  local title

  case "$cmd" in
    create)
      [ "$#" -ge 3 ] || { usage; exit 1; }
      local _c_repo="$2" _c_issue="$3"
      shift 3
      cmd_create "$_c_repo" "$_c_issue" "$@"
      ;;
    list)
      shift 1
      cmd_list "$@"
      ;;
    status)
      if [ "$#" -gt 2 ]; then
        usage
        exit 1
      fi
      cmd_status "${2:-}"
      ;;
    approve)
      [ "$#" -eq 3 ] || { usage; exit 1; }
      cmd_approve "$2" "$3"
      ;;
    spec-complete)
      [ "$#" -eq 3 ] || { usage; exit 1; }
      cmd_spec_complete "$2" "$3"
      ;;
    clean)
      [ "$#" -ge 3 ] || { usage; exit 1; }
      repo="$2"
      slug="$3"
      shift 3
      cmd_clean "$repo" "$slug" "$@"
      ;;
    deps)
      [ "$#" -ge 2 ] || { usage; exit 1; }
      subcmd="$2"
      case "$subcmd" in
        graph)
          [ "$#" -ge 4 ] || die "Usage: acorn deps graph <repo> <issue#> [<issue#>...]"
          repo="$3"
          shift 3
          cmd_deps_graph "$repo" "$@"
          ;;
        *)
          usage
          die "Unknown deps subcommand: $subcmd"
          ;;
      esac
      ;;
    issue)
      [ "$#" -ge 2 ] || { usage; exit 1; }
      subcmd="$2"
      case "$subcmd" in
        create)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          title="$4"
          shift 4
          cmd_issue_create "$repo" "$title" "$@"
          ;;
        plan)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          title="$4"
          shift 4
          cmd_issue_plan "$repo" "$title" "$@"
          ;;
        clarify)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          local _cl_issue="$4"
          shift 4
          cmd_issue_clarify "$repo" "$_cl_issue"
          ;;
        label)
          [ "$#" -ge 5 ] || { usage; exit 1; }
          repo="$3"
          local _lb_issue="$4"
          local _lb_label="$5"
          shift 5
          cmd_issue_label "$repo" "$_lb_issue" "$_lb_label"
          ;;
        split)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          local _sp_issue="$4"
          shift 4
          cmd_issue_split "$repo" "$_sp_issue" "$@"
          ;;
        depends)
          [ "$#" -ge 4 ] || { usage; exit 1; }
          repo="$3"
          local _dep_issue="$4"
          shift 4
          cmd_issue_depends "$repo" "$_dep_issue" "$@"
          ;;
        *)
          usage
          die "Unknown issue subcommand: $2"
          ;;
      esac
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      usage
      die "Unknown command: $cmd"
      ;;
  esac
}

main "$@"
